/* pages/index/index.wxss 鈥?楂樼骇鎰燂細娣卞钃?+ 灞傛鍏?*/
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1B2838 0%, #16213e 50%, #0f0f23 100%);
  padding: 0 36rpx 60rpx;
  position: relative;
  overflow: hidden;
}

/* 椤堕儴鍏夋檿锛氭煍鏈堢櫧 */
.glow-bg {
  position: absolute;
  top: -200rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 700rpx;
  height: 700rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(180,200,230,0.06) 0%, transparent 65%);
  pointer-events: none;
}

/* 澶撮儴 */
.header {
  padding: 100rpx 0 48rpx;
  position: relative;
}

.greeting {
  display: block;
  font-size: 34rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.8);
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}

.date {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.2);
  font-weight: 300;
  letter-spacing: 1rpx;
}

/* 璇勫垎鍗＄墖锛氭湀鐧界幓鐠?*/
.score-card {
  background: linear-gradient(145deg, rgba(180,200,230,0.06), rgba(200,220,240,0.02));
  border: 1rpx solid rgba(180,200,230,0.08);
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.score-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 30%, rgba(180,200,230,0.03), transparent 50%);
  pointer-events: none;
}

.score-card:active {
  opacity: 0.8;
}

/* 璇勫垎鐜細鏈堝厜鐧?*/
.score-circle {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(180,200,230,0.12), rgba(200,220,240,0.04));
  border: 4rpx solid rgba(180,200,230,0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  position: relative;
}

.circle-bg {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(180,200,230,0.04), transparent 65%);
  animation: pulse-glow 4s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

.score-num {
  font-size: 50rpx;
  font-weight: 200;
  color: rgba(255,255,255,0.85);
  line-height: 1;
  position: relative;
}

.score-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.2);
  margin-top: 4rpx;
  position: relative;
}

.score-title {
  display: block;
  font-size: 28rpx;
  font-weight: 350;
  color: rgba(255,255,255,0.55);
  margin-bottom: 4rpx;
  letter-spacing: 4rpx;
}

.score-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
  margin-bottom: 20rpx;
}

/* 一句话解读 */
.score-insight {
  display: block;
  font-size: 24rpx;
  color: #a0c4ff;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
  padding: 12rpx 20rpx;
  background: rgba(160, 196, 255, 0.06);
  border-radius: 16rpx;
  border: 1rpx solid rgba(160, 196, 255, 0.08);
}

/* 数据行 */
.score-stats-row {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.score-stat {
  text-align: center;
}

.score-stat-val {
  display: block;
  font-size: 32rpx;
  color: rgba(255,255,255,0.7);
  font-weight: 600;
}

.trend-good {
  color: #4caf50;
}

.trend-bad {
  color: #ff6b6b;
}

.score-stat-label {
  display: block;
  font-size: 18rpx;
  color: rgba(255,255,255,0.2);
  margin-top: 2rpx;
}

/* 杩炵画澶╂暟锛氭殩鏈ㄨ壊 */
.streak-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(200,180,150,0.06);
  border: 1rpx solid rgba(200,180,150,0.1);
  padding: 8rpx 28rpx;
  border-radius: 40rpx;
}

.streak-fire {
  font-size: 22rpx;
  margin-right: 8rpx;
}

.streak-text {
  font-size: 20rpx;
  color: rgba(200,180,150,0.5);
  letter-spacing: 2rpx;
}

/* 鍥捐〃鍗＄墖 */
.chart-card {
  background: rgba(255,255,255,0.02);
  border: 1rpx solid rgba(255,255,255,0.04);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.chart-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
  font-weight: 350;
  letter-spacing: 2rpx;
}

.chart-avg {
  font-size: 22rpx;
  color: rgba(255,255,255,0.15);
  font-weight: 300;
}

/* 下降警告 */
.chart-warning {
  display: flex;
  align-items: center;
  background: rgba(255, 107, 107, 0.06);
  border: 1rpx solid rgba(255, 107, 107, 0.1);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 20rpx;
}

.chart-warning-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.chart-warning-text {
  font-size: 22rpx;
  color: #ff6b6b;
  flex: 1;
}

.chart {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  height: 180rpx;
}

.bar-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}

.bar-track {
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar-fill {
  width: 100%;
  max-width: 36rpx;
  background: linear-gradient(180deg, rgba(180,200,230,0.3), rgba(180,200,230,0.06));
  border-radius: 18rpx 18rpx 6rpx 6rpx;
  min-height: 4rpx;
  transition: height 0.5s ease;
}

.bar-drop {
  background: linear-gradient(180deg, rgba(255,107,107,0.3), rgba(255,107,107,0.06)) !important;
}

.bar-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.12);
  margin-top: 10rpx;
}

/* 鍔熻兘鍏ュ彛锛氶浘鐏板害4瀹牸 */
.actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 60rpx;
}

.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.action:active {
  opacity: 0.5;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.action-icon::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  pointer-events: none;
}

.action-emoji {
  font-size: 40rpx;
  position: relative;
}

.action-name {
  font-size: 20rpx;
  color: rgba(255,255,255,0.35);
  font-weight: 350;
  letter-spacing: 2rpx;
}

/* 搴曢儴 */
.footer {
  text-align: center;
  padding: 10rpx 0 40rpx;
}

.footer-text {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.08);
  font-weight: 300;
  letter-spacing: 6rpx;
}


/* 管家提醒横幅 */
.butler-bar {
  display: flex;
  align-items: center;
  background: rgba(100,180,200,0.1);
  border: 1rpx solid rgba(100,180,200,0.15);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.butler-bar:active { opacity: 0.7; }
.butler-icon { font-size: 32rpx; margin-right: 16rpx; }
.butler-text { flex: 1; }
.butler-msg { display: block; font-size: 24rpx; color: rgba(255,255,255,0.75); line-height: 1.4; }
.butler-hint { display: block; font-size: 20rpx; color: rgba(100,180,200,0.5); margin-top: 4rpx; }

/* 商业智能简报 */
.brief-bar {
  display: flex;
  align-items: center;
  background: rgba(200,180,150,0.06);
  border: 1rpx solid rgba(200,180,150,0.08);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.brief-bar:active { opacity: 0.7; }
.brief-icon { font-size: 24rpx; margin-right: 12rpx; }
.brief-text { flex: 1; font-size: 22rpx; color: rgba(200,180,150,0.6); }
.brief-arrow { font-size: 20rpx; color: rgba(200,180,150,0.3); }

.brief-detail {
  background: rgba(200,180,150,0.04);
  border: 1rpx solid rgba(200,180,150,0.06);
  border-radius: 0 0 16rpx 16rpx;
  padding: 0 20rpx 16rpx;
  margin: -16rpx 0 16rpx;
}
.brief-item { padding: 12rpx 0; border-top: 1rpx solid rgba(200,180,150,0.06); }
.brief-item-title { display: block; font-size: 22rpx; color: rgba(200,180,150,0.7); margin-bottom: 4rpx; }
.brief-item-desc { display: block; font-size: 20rpx; color: rgba(200,180,150,0.35); }

/* 智能洞察列表 */
.insight-list {
  margin: 8rpx 0 0;
  padding: 0 8rpx;
}
.insight-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  gap: 8rpx;
}
.insight-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  width: 36rpx;
  text-align: center;
}
.insight-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.4;
  flex: 1;
}


