  align-items: center;
  padding: 20rpx 24rpx;
}

.alt-view-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.alt-view-title {
  flex: 1;
  font-size: 26rpx;
  color: rgba(102, 126, 234, 0.9);
  font-weight: 500;
}

.alt-view-expand {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

.alt-view-body {
  padding: 0 24rpx 24rpx;
}

.alt-view-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

.alt-view-note {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
