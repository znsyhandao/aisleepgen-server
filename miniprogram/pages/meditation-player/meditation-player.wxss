/* meditation-player.wxss — 冥想播放器样式 */
page { background: #0f0f23; min-height: 100vh; overflow: hidden; }

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.player-header {
  text-align: center;
  padding: 20rpx 0;
  flex-shrink: 0;
}

.series-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102,126,234,0.12);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.player-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e0d8f0;
  text-align: center;
  line-height: 1.3;
}

.player-subtitle {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  margin-top: 8rpx;
  flex-shrink: 0;
}

/* ===== 动画区域 ===== */
.visual-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 300rpx;
}

/* 呼吸呼吸圆 */
.breath-circle {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102,126,234,0.15) 0%, rgba(118,75,162,0.08) 100%);
  border: 2rpx solid rgba(102,126,234,0.2);
  animation: breathPulse 6s ease-in-out infinite;
  position: relative;
}

@keyframes breathPulse {
  0%, 100% { transform: scale(0.85); opacity: 0.7; }
  50% { transform: scale(1.1); opacity: 1; }
}

.breath-circle.playing {
  animation: breathPulse 6s ease-in-out infinite;
}

.breath-circle.paused {
  animation: none;
  opacity: 0.5;
}

.circle-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 80rpx;
}

/* 进度条 */
.progress-bar-wrap {
  width: 80%;
  height: 6rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 3rpx;
  margin-top: 40rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #a78bfa);
  border-radius: 3rpx;
  transition: width 0.3s;
}

.time-display {
  font-size: 28rpx;
  color: #888;
  margin-top: 12rpx;
  font-variant-numeric: tabular-nums;
}

/* ===== 控制按钮 ===== */
.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 30rpx 0;
  flex-shrink: 0;
}

.ctrl-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  transition: all 0.15s;
}

.ctrl-btn:active { transform: scale(0.9); }

.ctrl-btn.primary {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.4);
}

.ctrl-btn.secondary {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.06);
}

/* ===== 环境音选择 ===== */
.ambient-bar {
  flex-shrink: 0;
  padding: 16rpx 0;
}

.ambient-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ambient-label {
  font-size: 24rpx;
  color: #888;
}

.ambient-toggle {
  font-size: 28rpx;
  color: #667eea;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ambient-scroll {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 4rpx 0;
}

.ambient-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #888;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  flex-shrink: 0;
}

.ambient-chip.active {
  color: #e0d8f0;
  background: rgba(102,126,234,0.12);
  border-color: rgba(102,126,234,0.3);
}

/* ===== 完成 ===== */
.complete-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.complete-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.complete-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e0d8f0;
  display: block;
  margin-bottom: 8rpx;
}

.complete-sub {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 30rpx;
}

.rating-row {
  display: flex;
  gap: 24rpx;
}

.star {
  font-size: 56rpx;
  opacity: 0.3;
  transition: all 0.15s;
}

.star.filled { opacity: 1; }
.star:active { transform: scale(1.2); }

.skip-btn {
  font-size: 24rpx;
  color: #666;
  margin-top: 30rpx;
  padding: 16rpx;
}

/* ===== 手环数据浮窗 ===== */
.band-float {
  position: fixed;
  top: 120rpx;
  right: 20rpx;
  background: rgba(15,15,35,0.92);
  border: 1px solid rgba(102,126,234,0.2);
  border-radius: 20rpx;
  padding: 20rpx;
  min-width: 180rpx;
  z-index: 10;
}

.band-float-item {
  font-size: 22rpx;
  color: #ccc;
  display: block;
  margin-bottom: 6rpx;
}

.band-float-val {
  color: #667eea;
  font-weight: 600;
}

.band-toggle {
  position: fixed;
  top: 100rpx;
  right: 20rpx;
  font-size: 36rpx;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
}

/* ===== 日志 ===== */
.log-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.8);
  padding: 10rpx 20rpx;
  max-height: 120rpx;
  overflow-y: auto;
}

.log-line {
  font-size: 18rpx;
  color: #444;
  font-family: monospace;
  display: block;
  line-height: 1.4;
}
