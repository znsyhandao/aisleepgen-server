/* pages/settings/settings.wxss - 娑撴挷绗熺拋鍓х枂妞?*/
page {
  background: #0f3460;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", sans-serif;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1B2838 0%, #16213e 100%);
}

/* ===== 婢舵挳鍎?===== */
.header {
  padding: 80rpx 24rpx 16rpx;
  display: flex;
  align-items: center;
  background: rgba(15,15,35,0.85);
  backdrop-filter: blur(30px);
  border-bottom: 0.5px solid rgba(255,255,255,0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}
.header-left, .header-right {
  display: flex;
  width: 120rpx;
}
.header-right { justify-content: flex-end; }
.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}
.header-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-btn:active { background: rgba(255,255,255,0.1); }
.header-back { font-size: 26rpx; color: rgba(255,255,255,0.7); }
.header-icon { font-size: 28rpx; }

/* ===== 鐠佸墽鐤嗗姘З ===== */
.settings-scroll {
  padding: 0 24rpx;
  height: calc(100vh - 160rpx);
}

/* ===== 鐠佸墽鐤嗛崚鍡欑矋 ===== */
.setting-group {
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}
.group-icon {
  font-size: 28rpx;
}
.group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.group-items {
  background: rgba(255,255,255,0.03);
  border: 0.5px solid rgba(255,255,255,0.05);
  border-radius: 20rpx;
  overflow: hidden;
}

.group-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 0.5px solid rgba(255,255,255,0.04);
}
.group-item:last-child {
  border-bottom: none;
}
.group-item.row-action:active {
  background: rgba(255,255,255,0.04);
}

.item-info {
  flex: 1;
  min-width: 0;
}
.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-bottom: 4rpx;
}
.item-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-control {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.item-switch {
  transform: scale(0.75);
}

.row-arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,0.15);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.bottom-spacer {
  height: 40rpx;
}
