<!-- pages/settings/settings.wxml - 专业设置页 -->
<view class="container">

  <!-- 头部 -->
  <view class="header">
    <view class="header-left">
      <view class="header-btn" bindtap="goBack" wx:if="{{showBackButton}}">
        <text class="header-back">‹ 返回</text>
      </view>
    </view>
    <text class="title">设置</text>
    <view class="header-right">
      <view class="header-btn" bindtap="exportData">
        <text class="header-icon">📤</text>
      </view>
    </view>
  </view>

  <scroll-view class="settings-scroll" scroll-y show-scrollbar="{{false}}">
    
    <!-- ===== 设置分组 ===== -->
    <view class="setting-group" wx:for="{{settingGroups}}" wx:for-index="gidx" wx:key="title">
      <view class="group-header">
        <text class="group-icon">{{item.icon}}</text>
        <text class="group-title">{{item.title}}</text>
      </view>
      
      <view class="group-items">
        <view class="group-item" wx:for="{{item.items}}" wx:for-index="iidx" wx:key="id">
          <view class="item-info">
            <text class="item-label">{{item.label}}</text>
            <text class="item-desc">{{item.desc}}</text>
          </view>
          <view class="item-control">
            <switch class="item-switch" checked="{{item.value}}" 
                    data-gidx="{{gidx}}" data-iidx="{{iidx}}" 
                    bindchange="toggleSwitch" color="#667eea"/>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 工具 ===== -->
    <view class="setting-group">
      <view class="group-header">
        <text class="group-icon">🛠️</text>
        <text class="group-title">工具</text>
      </view>
      
      <view class="group-items">
        <view class="group-item row-action" bindtap="resetToDefault">
          <view class="item-info">
            <text class="item-label">恢复默认设置</text>
            <text class="item-desc">将所有设置重置为初始值</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="group-item row-action" bindtap="clearCache">
          <view class="item-info">
            <text class="item-label">清除缓存</text>
            <text class="item-desc">清除本地缓存临时文件</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="group-item row-action" bindtap="exportData">
          <view class="item-info">
            <text class="item-label">数据导出</text>
            <text class="item-desc">导出您的睡眠数据</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- ===== 关于 ===== -->
    <view class="setting-group">
      <view class="group-header">
        <text class="group-icon">ℹ️</text>
        <text class="group-title">关于</text>
      </view>
      
      <view class="group-items">
        <view class="group-item row-action" bindtap="viewAbout">
          <view class="item-info">
            <text class="item-label">关于 {{appInfo.name}}</text>
            <text class="item-desc">版本 {{appInfo.version}} · {{appInfo.tagline}}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="group-item row-action" bindtap="checkUpdate">
          <view class="item-info">
            <text class="item-label">检查更新</text>
            <text class="item-desc">查看是否有新版本</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="group-item row-action" bindtap="contactSupport">
          <view class="item-info">
            <text class="item-label">联系支持</text>
            <text class="item-desc">获取帮助或反馈问题</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

</view>
