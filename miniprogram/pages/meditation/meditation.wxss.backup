/* pages/meditation/meditation.wxss - 基础版本 */
.container {
  padding: 0;
  min-height: 100vh;
  background: #f5f7fa;
}

/* 头部 */
.header {
  background: white;
  padding: 30rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left, .header-right {
  width: 120rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  flex: 1;
}

.back-btn {
  font-size: 28rpx;
  color: #4A90E2;
  background: none;
  border: none;
  padding: 0;
}

.icon-btn {
  font-size: 36rpx;
  background: none;
  border: none;
  padding: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
}

/* 内容区域 */
.content {
  padding: 40rpx;
}

/* 当前冥想 */
.current-meditation {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.meditation-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(102,126,234,0.3);
}

.meditation-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 15rpx;
}

.meditation-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  margin-bottom: 25rpx;
  line-height: 1.5;
}

.meditation-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 播放器 */
.player-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  text-align: center;
}

.player-status {
  margin-bottom: 30rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90E2;
}

.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.time-current, .time-total {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  min-width: 80rpx;
  text-align: center;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

/* 播放控制 */
.player-controls {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 30rpx;
}

.control-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  font-size: 40rpx;
  background: white;
  border: 2rpx solid #e8e8e8;
  padding: 0;
  line-height: 100rpx;
  text-align: center;
}

.control-btn.primary {
  background: #4A90E2;
  color: white;
  border: none;
  font-size: 30rpx;
  width: 240rpx;
  height: 100rpx;
  border-radius: 50rpx;
  line-height: 100rpx;
}

.control-btn:active {
  transform: scale(0.95);
}

/* 冥想列表 */
.section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.meditation-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meditation-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s;
}

.meditation-item:active {
  background: #e9ecef;
  transform: scale(0.99);
}

.item-left {
  flex: 1;
  margin-right: 20rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.item-meta {
  display: flex;
  gap: 15rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: #4A90E2;
  background: #e8f4ff;
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
}

.meta-time {
  font-size: 22rpx;
  color: #666;
  background: #e8e8e8;
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
}

.favorite-btn {
  font-size: 36rpx;
  background: none;
  border: none;
  padding: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
}

/* 设置区域 */
.setting-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}

.sound-options, .voice-options {
  display: flex;
  gap: 15rpx;
}

.sound-btn, .voice-btn {
  font-size: 24rpx;
  padding: 15rpx 25rpx;
  border-radius: 20rpx;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  color: #555;
  transition: all 0.2s;
}

.sound-btn.active, .voice-btn.active {
  background: #e8f4ff;
  border-color: #4A90E2;
  color: #4A90E2;
}

.sound-btn:active, .voice-btn:active {
  transform: scale(0.97);
}

/* 信息框 */
.info-box {
  background: #e8f4ff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A90E2;
  display: block;
  margin-bottom: 20rpx;
}

.info-text {
  display: block;
  font-size: 24rpx;
  color: #555;
  margin-bottom: 10rpx;
  padding-left: 20rpx;
  position: relative;
}

.info-text::before {
  content: "•";
  position: absolute;
  left: 0;
  color: #4A90E2;
}