.star.filled { opacity: 1; animation: pop 0.3s ease-out; }
@keyframes fadeIn { 0% { opacity: 0.3; transform: translateY(5rpx); } 100% { opacity: 1; transform: translateY(0); } }
@keyframes pop {
  0% { transform: scale(0.8); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* ===== 水平进度条 ===== */
.bar-wrap {
  z-index: 1; position: relative;
  width: 80%; max-width: 500rpx;
  margin-bottom: 40rpx;
  display: flex; flex-direction: column; align-items: center;
}
.bar-bg {
  width: 100%; height: 16rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7c4dff, #448aff);
  border-radius: 8rpx;
  transition: none;  /* 不动画，不触发重排 */
}
.bar-info {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%;
  margin-top: 16rpx;
}
.bar-pct { color: #e8e0ff; font-size: 34rpx; font-weight: 300; letter-spacing: 4rpx; }
.bar-time { color: rgba(200,190,255,0.35); font-size: 24rpx; letter-spacing: 4rpx; }

/* ===== 指令 ===== */
.instruction-box {
  z-index: 1; position: relative;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 30rpx;
  width: 100%; max-width: 600rpx;
  box-sizing: border-box;
  text-align: center;
  min-height: 200rpx;
  padding: 48rpx 44rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.instruction-text { color: #fff; font-size: 36rpx; font-weight: 500; line-height: 1.6; }
.instruction-area { color: rgba(200,190,255,0.3); font-size: 22rpx; letter-spacing: 4rpx; margin-top: 16rpx; }
