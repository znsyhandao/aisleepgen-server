.particle-layer.surrender .p2 { background: rgba(144,202,249,0.15);  animation: drift_2 26s ease-in-out infinite 5s;}
.particle-layer.surrender .p3 { background: rgba(120,144,156,0.2);  animation: drift_3 24s ease-in-out infinite 2s;}
.particle-layer.surrender .p4 { background: rgba(207,216,220,0.1);  animation: drift_4 28s ease-in-out infinite 7s;}
.particle-layer.surrender .p5 { background: rgba(176,190,197,0.18);  animation: drift_5 20s ease-in-out infinite 3s;}
.particle-layer.surrender .p6 { background: rgba(120,144,156,0.08);  animation: drift_6 30s ease-in-out infinite 1s;}

/* preparation（睡前检查 李子紫） */
.particle-layer.preparation .p1 { background: rgba(156,138,181,0.25);  animation: drift_1 22s ease-in-out infinite 0s;}
.particle-layer.preparation .p2 { background: rgba(206,147,216,0.15);  animation: drift_2 26s ease-in-out infinite 5s;}
.particle-layer.preparation .p3 { background: rgba(156,138,181,0.2);  animation: drift_3 24s ease-in-out infinite 2s;}
.particle-layer.preparation .p4 { background: rgba(225,190,231,0.1);  animation: drift_4 28s ease-in-out infinite 7s;}
.particle-layer.preparation .p5 { background: rgba(206,147,216,0.18);  animation: drift_5 20s ease-in-out infinite 3s;}
.particle-layer.preparation .p6 { background: rgba(156,138,181,0.08);  animation: drift_6 30s ease-in-out infinite 1s;}

/* clarity（挑战坏想法 米色） */
.particle-layer.clarity .p1 { background: rgba(188,170,164,0.25);  animation: drift_1 22s ease-in-out infinite 0s;}
.particle-layer.clarity .p2 { background: rgba(215,204,200,0.15);  animation: drift_2 26s ease-in-out infinite 5s;}
.particle-layer.clarity .p3 { background: rgba(188,170,164,0.2);  animation: drift_3 24s ease-in-out infinite 2s;}
.particle-layer.clarity .p4 { background: rgba(239,235,233,0.1);  animation: drift_4 28s ease-in-out infinite 7s;}
.particle-layer.clarity .p5 { background: rgba(215,204,200,0.18);  animation: drift_5 20s ease-in-out infinite 3s;}
