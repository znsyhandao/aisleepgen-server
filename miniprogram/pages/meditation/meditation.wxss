/* pages/meditation/meditation.wxss - 沉浸式引导 v2 */
.container {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a1a 0%, #1a1040 50%, #0d0d2b 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.1);
  border-top-color: #7c4dff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  color: rgba(255,255,255,0.5);
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* ===== 就绪态 ===== */
.ready-box {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; height: 100vh; padding: 0 40rpx;
}
.ready-icon { font-size: 120rpx; margin-bottom: 30rpx; animation: float 3s ease-in-out infinite; }
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}
.ready-title { color: #e8e0ff; font-size: 48rpx; font-weight: 300; letter-spacing: 8rpx; margin-bottom: 16rpx; text-shadow: 0 0 40rpx rgba(124,77,255,0.3); }
.ready-desc { color: rgba(200,190,255,0.5); font-size: 26rpx; letter-spacing: 4rpx; text-align: center; margin-bottom: 12rpx; line-height: 2; }
.ready-time { color: rgba(200,190,255,0.3); font-size: 22rpx; letter-spacing: 6rpx; margin-bottom: 60rpx; }
.start-btn {
  background: linear-gradient(135deg, #7c4dff 0%, #448aff 100%);
  color: #fff; font-size: 32rpx; font-weight: 500;
  padding: 24rpx 80rpx; border-radius: 50rpx;
  box-shadow: 0 8rpx 32rpx rgba(124,77,255,0.4);
  margin-bottom: 24rpx;
}
.back-btn { color: rgba(255,255,255,0.4); font-size: 26rpx; padding: 16rpx; }

/* ===== CSS圆环 ===== */
.guide-box {
  position: relative;
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; min-height: 80vh; width: 100%;
}
.guide-box::before {
  content: '';
  position: absolute;
  top: 15%;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(124,77,255,0.08) 0%, transparent 70%);
  pointer-events: none;
}
.guide-box {
  position: relative;
}







/* ===== 指令 ===== */
.instruction-box {
  z-index: 1; position: relative;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 30rpx;
  width: 100%; max-width: 600rpx;
  box-sizing: border-box;
  text-align: center;
  height: 180rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  overflow: hidden;
}
.instruction-text { color: #f0ecff; font-size: 34rpx; font-weight: 300; letter-spacing: 6rpx; line-height: 1.8; animation: fadeIn 0.6s ease; text-shadow: 0 0 30rpx rgba(124,77,255,0.15); }
.instruction-area { color: rgba(200,190,255,0.3); font-size: 22rpx; letter-spacing: 4rpx; margin-top: 16rpx; }

/* ===== 步进点（简化，最多9个） ===== */
.step-row {
  display: flex; align-items: center; justify-content: center;
  gap: 10rpx; margin-bottom: 16rpx;
}
.step-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: rgba(255,255,255,0.12);
  transition: transform 0.3s, background 0.3s;
}
.step-dot.active {
  background: #7c4dff;
  width: 22rpx; height: 22rpx;
  box-shadow: 0 0 12rpx rgba(124,77,255,0.6);
}
.step-dot.done { background: rgba(124,77,255,0.4); }

/* 轮次 */
.cycle-info { color: rgba(200,190,255,0.2); font-size: 20rpx; letter-spacing: 8rpx; margin-bottom: 40rpx; }

/* ===== 控制按钮 ===== */
.controls { display: flex; gap: 24rpx; align-items: center; }
.ctrl-btn {
  padding: 18rpx 44rpx; border-radius: 60rpx;
  font-size: 24rpx; font-weight: 300;
  letter-spacing: 4rpx;
}

.ctrl-btn.pause { background: rgba(255,255,255,0.06); color: rgba(240,236,255,0.7); }
.ctrl-btn.resume { background: linear-gradient(135deg, #7c4dff 0%, #448aff 100%); color: #fff; }
.ctrl-btn.stop { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.5); border: 1rpx solid rgba(255,255,255,0.1); }

/* 声音开关 */
.sound-wrap {
  display: flex; align-items: center; justify-content: center;
  margin-top: 40rpx;
}
.sound-icon { font-size: 36rpx; opacity: 0.5; }

/* ===== 完成态 ===== */
.complete-box {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; height: 100vh;
}
.complete-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.complete-title { color: #fff; font-size: 40rpx; font-weight: 600; margin-bottom: 12rpx; }
.complete-sub { color: rgba(255,255,255,0.5); font-size: 28rpx; margin-bottom: 40rpx; }
.rating-row { display: flex; gap: 20rpx; }
.star { font-size: 56rpx; opacity: 0.3; transition: transform 0.3s, background 0.3s; }

/* ===== 氛围粒子层 ===== */
.particle-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}
.particle {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

/* ---- 光点浮动（通用） ---- */
.p1 { width: 120rpx; height: 120rpx; background: rgba(124,77,255,0.12); left: 10%; top: 80%; }
.p2 { width: 180rpx; height: 180rpx; background: rgba(68,138,255,0.1); left: 70%; top: 60%; }
.p3 { width: 100rpx; height: 100rpx; background: rgba(124,77,255,0.08); left: 40%; top: 90%; }
.p4 { width: 200rpx; height: 200rpx; background: rgba(68,138,255,0.06); left: 20%; top: 70%; }
.p5 { width: 80rpx; height: 80rpx; background: rgba(255,255,255,0.06); left: 60%; top: 85%; }
.p6 { width: 150rpx; height: 150rpx; background: rgba(124,77,255,0.04); left: 50%; top: 75%; }


