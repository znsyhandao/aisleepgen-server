.particle-layer.release .p5 { background: rgba(188,170,164,0.18);  animation: drift_5 20s ease-in-out infinite 3s;}
.particle-layer.release .p6 { background: rgba(161,136,127,0.08);  animation: drift_6 30s ease-in-out infinite 1s;}

/* surrender（努力清醒 石板灰） */
