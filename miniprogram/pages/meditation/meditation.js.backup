// pages/meditation/meditation.js - 基础版本
Page({
  data: {
    pageName: 'meditation',
    showBackButton: false,
    
    // 冥想状态
    meditationStatus: 'idle', // idle, playing, paused, completed
    currentTime: 0,
    totalTime: 600, // 10分钟
    progress: 0,
    
    // 当前冥想
    currentMeditation: {
      id: 1,
      title: '深度放松冥想',
      description: '帮助您快速进入放松状态，改善睡眠质量',
      duration: 600,
      category: '睡眠',
      instructor: '张老师'
    },
    
    // 冥想列表
    meditations: [
      {
        id: 1,
        title: '深度放松冥想',
        description: '快速进入放松状态',
        duration: 600,
        category: '睡眠',
        favorite: true
      },
      {
        id: 2,
        title: '呼吸调节练习',
        description: '平衡呼吸节奏',
        duration: 300,
        category: '呼吸',
        favorite: false
      },
      {
        id: 3,
        title: '身体扫描冥想',
        description: '全身放松练习',
        duration: 900,
        category: '放松',
        favorite: true
      },
      {
        id: 4,
        title: '正念睡眠引导',
        description: '改善入睡困难',
        duration: 1200,
        category: '睡眠',
        favorite: false
      }
    ],
    
    // 播放器设置
    playerSettings: {
      volume: 80,
      backgroundSound: 'rain',
      guidanceVoice: 'female'
    },
    
    // 定时器
    timer: null
  },
  
  onLoad() {
    console.log('冥想页面加载');
    
    // 检查页面栈
    const pages = getCurrentPages();
    if (pages.length > 1) {
      this.setData({
        showBackButton: true
      });
    }
    
    // 加载设置
    this.loadSettings();
  },
  
  loadSettings() {
    const savedSettings = wx.getStorageSync('meditation_settings');
    if (savedSettings) {
      this.setData({
        playerSettings: savedSettings
      });
    }
  },
  
  saveSettings() {
    wx.setStorageSync('meditation_settings', this.data.playerSettings);
  },
  
  // 选择冥想
  selectMeditation(e) {
    const id = e.currentTarget.dataset.id;
    const meditation = this.data.meditations.find(m => m.id === id);
    
    if (meditation) {
      this.setData({
        currentMeditation: meditation,
        totalTime: meditation.duration,
        meditationStatus: 'idle',
        currentTime: 0,
        progress: 0
      });
      
      // 停止当前播放
      this.stopMeditation();
      
      wx.showToast({
        title: `已选择: ${meditation.title}`,
        icon: 'success'
      });
    }
  },
  
  // 开始冥想
  startMeditation() {
    if (this.data.meditationStatus === 'playing') {
      return;
    }
    
    this.setData({
      meditationStatus: 'playing'
    });
    
    // 开始计时
    this.startTimer();
    
    wx.showToast({
      title: '开始冥想',
      icon: 'success'
    });
  },
  
  // 开始计时器
  startTimer() {
    this.clearTimer();
    
    this.timer = setInterval(() => {
      let currentTime = this.data.currentTime + 1;
      let progress = (currentTime / this.data.totalTime) * 100;
      
      if (currentTime >= this.data.totalTime) {
        currentTime = this.data.totalTime;
        progress = 100;
        this.completeMeditation();
      }
      
      this.setData({
        currentTime,
        progress
      });
    }, 1000);
  },
  
  // 暂停冥想
  pauseMeditation() {
    if (this.data.meditationStatus !== 'playing') {
      return;
    }
    
    this.setData({
      meditationStatus: 'paused'
    });
    
    this.clearTimer();
    
    wx.showToast({
      title: '已暂停',
      icon: 'success'
    });
  },
  
  // 恢复冥想
  resumeMeditation() {
    if (this.data.meditationStatus !== 'paused') {
      return;
    }
    
    this.setData({
      meditationStatus: 'playing'
    });
    
    this.startTimer();
    
    wx.showToast({
      title: '继续冥想',
      icon: 'success'
    });
  },
  
  // 停止冥想
  stopMeditation() {
    this.setData({
      meditationStatus: 'idle',
      currentTime: 0,
      progress: 0
    });
    
    this.clearTimer();
    
    wx.showToast({
      title: '已停止',
      icon: 'success'
    });
  },
  
  // 完成冥想
  completeMeditation() {
    this.clearTimer();
    
    this.setData({
      meditationStatus: 'completed',
      currentTime: this.data.totalTime,
      progress: 100
    });
    
    // 显示完成提示
    setTimeout(() => {
      wx.showModal({
        title: '冥想完成',
        content: `您已完成 ${this.formatTime(this.data.totalTime)} 的冥想练习`,
        showCancel: false,
        confirmText: '太棒了！'
      });
    }, 500);
  },
  
  // 清理定时器
  clearTimer() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
  },
  
  // 格式化时间
  formatTime(seconds) {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  },
  
  // 切换收藏
  toggleFavorite(e) {
    const id = e.currentTarget.dataset.id;
    const index = this.data.meditations.findIndex(m => m.id === id);
    
    if (index >= 0) {
      const key = `meditations[${index}].favorite`;
      const newValue = !this.data.meditations[index].favorite;
      
      this.setData({
        [key]: newValue
      });
      
      wx.showToast({
        title: newValue ? '已收藏' : '已取消收藏',
        icon: 'success'
      });
    }
  },
  
  // 更新音量
  updateVolume(e) {
    const volume = e.detail.value;
    this.setData({
      'playerSettings.volume': volume
    });
    
    this.saveSettings();
  },
  
  // 切换背景音
  changeBackgroundSound(e) {
    const sound = e.currentTarget.dataset.sound;
    this.setData({
      'playerSettings.backgroundSound': sound
    });
    
    this.saveSettings();
    
    wx.showToast({
      title: `背景音: ${sound}`,
      icon: 'success'
    });
  },
  
  // 切换引导声音
  changeGuidanceVoice(e) {
    const voice = e.currentTarget.dataset.voice;
    this.setData({
      'playerSettings.guidanceVoice': voice
    });
    
    this.saveSettings();
    
    wx.showToast({
      title: `引导声音: ${voice === 'female' ? '女声' : '男声'}`,
      icon: 'success'
    });
  },
  
  // 设置提醒
  setReminder() {
    wx.showToast({
      title: '提醒设置功能开发中',
      icon: 'none'
    });
  },
  
  // 返回
  goBack() {
    const pages = getCurrentPages();
    if (pages.length > 1) {
      wx.navigateBack();
    } else {
      wx.switchTab({
        url: '/pages/index/index'
      });
    }
  },
  
  onUnload() {
    // 清理定时器
    this.clearTimer();
  }
});