<!--pages/analyze/analyze.wxml-->
<view class="container">
  <!-- 分析状态 -->
  <view class="status-card">
    <view class="status-header">
      <text class="status-title">睡眠分析</text>
      <text class="status-indicator {{analysisStatus}}">
        {{analysisStatus === 'idle' ? '准备开始' : 
          analysisStatus === 'recording' ? '采集中' : 
          analysisStatus === 'analyzing' ? '分析中' : '已完成'}}
      </text>
    </view>
    
    <view class="status-content">
      <block wx:if="{{analysisStatus === 'idle'}}">
        <text class="status-text">点击开始按钮进行睡眠分析</text>
        <text class="status-hint">建议在睡前或睡眠中进行</text>
      </block>
      
      <block wx:if="{{analysisStatus === 'recording'}}">
        <view class="recording-info">
          <text class="recording-time">{{recordingTime}}秒</text>
          <text class="recording-text">数据采集中...</text>
        </view>
      </block>
      
      <block wx:if="{{analysisStatus === 'analyzing'}}">
        <view class="analyzing-info">
          <progress class="progress-bar" percent="{{analysisProgress}}" show-info stroke-width="6" />
          <text class="analyzing-text">正在分析睡眠数据</text>
        </view>
      </block>
      
      <block wx:if="{{analysisStatus === 'completed'}}">
        <view class="completed-info">
          <text class="completed-text">✓ 分析完成</text>
          <text class="completed-hint">点击查看详细报告</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 实时数据 -->
  <view class="realtime-card" wx:if="{{analysisStatus === 'recording' || analysisStatus === 'analyzing'}}">
    <view class="section-title">
      <text>实时数据</text>
    </view>
    
    <view class="realtime-grid">
      <view class="data-item">
        <text class="data-label">心率</text>
        <text class="data-value">{{realtimeData.heartRate}}</text>
        <text class="data-unit">BPM</text>
      </view>
      
      <view class="data-item">
        <text class="data-label">呼吸</text>
        <text class="data-value">{{realtimeData.breathRate}}</text>
        <text class="data-unit">次/分</text>
      </view>
      
      <view class="data-item">
        <text class="data-label">体动</text>
        <text class="data-value">{{realtimeData.movement}}</text>
      </view>
      
      <view class="data-item">
        <text class="data-label">睡眠阶段</text>
        <text class="data-value">{{realtimeData.sleepStage}}</text>
      </view>
    </view>
  </view>

  <!-- 控制按钮 -->
  <view class="control-buttons">
    <block wx:if="{{analysisStatus === 'idle'}}">
      <button class="btn-primary" bindtap="startAnalysis">
        <text class="btn-icon">▶</text>
        <text>开始分析</text>
      </button>
      
      <button class="btn-secondary" bindtap="uploadData">
        <text class="btn-icon">📁</text>
        <text>上传数据</text>
      </button>
    </block>
    
    <block wx:if="{{analysisStatus === 'recording'}}">
      <button class="btn-warning" bindtap="stopRecording">
        <text class="btn-icon">⏹</text>
        <text>停止采集</text>
      </button>
    </block>
    
    <block wx:if="{{analysisStatus === 'analyzing'}}">
      <button class="btn-disabled" disabled>
        <text class="btn-icon">⏳</text>
        <text>分析中 {{analysisProgress}}%</text>
      </button>
    </block>
    
    <block wx:if="{{analysisStatus === 'completed'}}">
      <button class="btn-primary" bindtap="viewReport" data-date="{{getCurrentDate()}}">
        <text class="btn-icon">📊</text>
        <text>查看报告</text>
      </button>
      
      <button class="btn-secondary" bindtap="shareResult">
        <text class="btn-icon">↗</text>
        <text>分享结果</text>
      </button>
      
      <button class="btn-outline" bindtap="startAnalysis">
        <text class="btn-icon">🔄</text>
        <text>重新分析</text>
      </button>
    </block>
  </view>

  <!-- 分析结果预览 -->
  <view class="result-preview" wx:if="{{analysisResult}}">
    <view class="section-title">
      <text>分析结果</text>
    </view>
    
    <view class="result-summary">
      <view class="score-display">
        <text class="score-value">{{analysisResult.score}}</text>
        <text class="score-label">睡眠评分</text>
      </view>
      
      <view class="result-details">
        <view class="detail-item">
          <text class="detail-label">时长</text>
          <text class="detail-value">{{analysisResult.duration}}</text>
        </view>
        
        <view class="detail-item">
          <text class="detail-label">质量</text>
          <text class="detail-value">{{analysisResult.quality}}</text>
        </view>
      </view>
    </view>
    
    <view class="stage-distribution">
      <view class="stage-item" style="width: {{analysisResult.stages.awake}}%">
        <text class="stage-label">清醒</text>
        <text class="stage-percent">{{analysisResult.stages.awake}}%</text>
      </view>
      
      <view class="stage-item n1" style="width: {{analysisResult.stages.n1}}%">
        <text class="stage-label">N1</text>
        <text class="stage-percent">{{analysisResult.stages.n1}}%</text>
      </view>
      
      <view class="stage-item n2" style="width: {{analysisResult.stages.n2}}%">
        <text class="stage-label">N2</text>
        <text class="stage-percent">{{analysisResult.stages.n2}}%</text>
      </view>
      
      <view class="stage-item n3" style="width: {{analysisResult.stages.n3}}%">
        <text class="stage-label">N3</text>
        <text class="stage-percent">{{analysisResult.stages.n3}}%</text>
      </view>
      
      <view class="stage-item rem" style="width: {{analysisResult.stages.rem}}%">
        <text class="stage-label">REM</text>
        <text class="stage-percent">{{analysisResult.stages.rem}}%</text>
      </view>
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="history-section">
    <view class="section-title">
      <text>历史记录</text>
      <text class="view-all" bindtap="viewReport" data-date="all">查看全部 ></text>
    </view>
    
    <view class="history-list">
      <block wx:for="{{historyRecords}}" wx:key="date">
        <view class="history-item" bindtap="viewReport" data-date="{{item.date}}">
          <view class="history-date">
            <text>{{item.date}}</text>
            <text class="history-weekday">周四</text>
          </view>
          
          <view class="history-score">
            <text class="score">{{item.score}}</text>
            <text class="score-label">分</text>
          </view>
          
          <view class="history-duration">
            <text>{{item.duration}}</text>
          </view>
          
          <view class="history-quality">
            <text class="quality-badge {{item.quality}}">{{item.quality}}</text>
          </view>
          
          <view class="history-action">
            <text class="action-icon">→</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 使用提示 -->
  <view class="tips-section">
    <view class="section-title">
      <text>使用提示</text>
    </view>
    
    <view class="tips-list">
      <view class="tip-item">
        <text class="tip-icon">💡</text>
        <text class="tip-text">建议在安静的环境下进行分析</text>
      </view>
      
      <view class="tip-item">
        <text class="tip-icon">💡</text>
        <text class="tip-text">保持设备稳定，避免移动</text>
      </view>
      
      <view class="tip-item">
        <text class="tip-icon">💡</text>
        <text class="tip-text">分析时间建议10-30秒</text>
      </view>
      
      <view class="tip-item">
        <text class="tip-icon">💡</text>
        <text class="tip-text">结果仅供参考，如有疑问请咨询医生</text>
      </view>
    </view>
  </view>
</view>