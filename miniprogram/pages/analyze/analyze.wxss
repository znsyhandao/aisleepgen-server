/* pages/analyze/analyze.wxss — 数据看板版 */
.page {
  min-height: 100vh;
  background: #0f0f23;
  padding: 0 30rpx 60rpx;
}

/* ── 骨架屏 ── */
.skeleton { padding: 40rpx 0; }
.s-block { background: rgba(255,255,255,0.06); border-radius: 8rpx; }
.s-card { background: rgba(255,255,255,0.03); border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; }
.s-row { display: flex; margin-bottom: 20rpx; }

/* ── 页面标题 ── */
.page-header { padding: 30rpx 0 20rpx; }
.page-title { font-size: 36rpx; color: rgba(255,255,255,0.9); font-weight: 600; }
.page-sub { font-size: 24rpx; color: rgba(255,255,255,0.3); margin-top: 6rpx; display: block; }

/* ── 核心统计 ── */
.stat-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.stat-card {
  flex: 1;
  background: rgba(255,255,255,0.04);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1rpx solid rgba(255,255,255,0.06);
}
.stat-value { font-size: 48rpx; font-weight: 200; color: #4A90E2; display: block; }
.stat-value.fire { color: #FF6B35; }
.stat-value.trend-up { color: #4CAF50; }
.stat-value.trend-down { color: #F44336; }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.4); margin-top: 6rpx; display: block; }
.stat-sub { font-size: 20rpx; margin-top: 4rpx; display: block; }
.stat-sub.trend-up { color: #4CAF50; }
.stat-sub.trend-down { color: #F44336; }

/* ── 通用卡片 ── */
.card {
  background: rgba(255,255,255,0.04);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
}
.card-header { margin-bottom: 16rpx; }
.card-title { font-size: 28rpx; color: rgba(255,255,255,0.8); font-weight: 500; }
.card-more { font-size: 24rpx; color: #4A90E2; }

/* ── 7天趋势条形图 ── */
.chart-bar-container {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
  padding: 20rpx 0;
  gap: 12rpx;
}
.chart-bar-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.chart-bar-bg {
  flex: 1;
  width: 100%;
  background: rgba(74,144,226,0.1);
  border-radius: 12rpx 12rpx 0 0;
  position: relative;
  display: flex;
  align-items: flex-end;
}
.chart-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #4A90E2, rgba(74,144,226,0.4));
  border-radius: 12rpx 12rpx 0 0;
  transition: height 0.3s;
  min-height: 20rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 6rpx;
}
.chart-bar-value {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}
.chart-bar-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 8rpx;
}

/* ── 干预效果 ── */
.effect-grid {
  display: flex;
  gap: 12rpx;
}
.effect-item {
  flex: 1;
  background: rgba(74,144,226,0.08);
  border-radius: 12rpx;
  padding: 16rpx 10rpx;
  text-align: center;
}
.effect-value { font-size: 36rpx; font-weight: 300; color: #4A90E2; display: block; }
.effect-value.fire { color: #FF6B35; }
.effect-label { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-top: 4rpx; display: block; }

.stress-type { margin-top: 16rpx; }
.stress-title { font-size: 22rpx; color: rgba(255,255,255,0.5); }
.stress-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.stress-tag {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.06);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

/* ── 最近记录 ── */
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255,255,255,0.04);
}
.record-item:active { opacity: 0.6; }
.record-left { display: flex; flex-direction: column; gap: 4rpx; }
.record-date { font-size: 28rpx; color: rgba(255,255,255,0.7); }
.record-dur { font-size: 22rpx; color: rgba(255,255,255,0.25); }
.record-right { display: flex; align-items: baseline; gap: 4rpx; }
.record-score { font-size: 36rpx; font-weight: 300; color: #4A90E2; }
.record-unit { font-size: 22rpx; color: rgba(74,144,226,0.4); }
.record-arrow { font-size: 32rpx; color: rgba(255,255,255,0.12); margin-left: 8rpx; }

/* ── CTA 按钮 ── */
.cta-section { padding: 20rpx 0 40rpx; }
.cta-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: opacity 0.2s;
}
.cta-btn::after { border: none; }
.cta-btn:active { opacity: 0.8; }

/* ===== 深度洞察卡片 ===== */
.insight-section {
  padding: 20rpx 24rpx;
  margin-top: 10rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #c0c0e0;
  margin-bottom: 16rpx;
}
.insight-card {
  background: rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  backdrop-filter: blur(10px);
}
.insight-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.insight-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.insight-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #d0d0f0;
}
.insight-desc {
  font-size: 26rpx;
  color: #a0a0c0;
  line-height: 1.5;
}
