// pages/analyze/analyze.js - 增强版
Page({
  data: {
    pageName: 'analyze',
    analysisStatus: 'ready', // ready, analyzing, completed, error
    progress: 0,
    analysisType: 'auto', // auto, manual, quick
    estimatedTime: '约3分钟',
    
    // 实时数据
    realTimeData: {
      heartRate: 72,
      breathingRate: 16,
      movement: '轻微',
      noiseLevel: '安静',
      lightLevel: '黑暗'
    },
    
    // 分析选项
    analysisOptions: [
      { id: 'auto', name: '自动分析', desc: '系统自动选择最佳分析模式', icon: '🤖', selected: true },
      { id: 'manual', name: '手动设置', desc: '自定义分析参数', icon: '⚙️', selected: false },
      { id: 'quick', name: '快速分析', desc: '简化版快速分析', icon: '⚡', selected: false }
    ],
    
    // 手动设置选项
    manualSettings: {
      duration: 30, // 分钟
      sensitivity: 'medium', // low, medium, high
      saveRawData: true,
      enableAudio: false
    },
    
    // 分析历史
    recentAnalyses: [
      { time: '昨天 22:30', score: 82, duration: '7h 15m', type: '自动分析' },
      { time: '前天 23:15', score: 78, duration: '6h 45m', type: '快速分析' },
      { time: '04-20 22:45', score: 85, duration: '7h 30m', type: '自动分析' }
    ]
  },
  
  onLoad() {
    console.log('分析页面加载（增强版）');
    this.loadAnalysisHistory();
  },
  
  onShow() {
    console.log('分析页面显示');
  },
  
  // 加载分析历史
  loadAnalysisHistory() {
    const history = wx.getStorageSync('analysis_history') || [];
    if (history.length > 0) {
      this.setData({
        recentAnalyses: history.slice(0, 3) // 只显示最近3条
      });
    }
  },
  
  // 选择分析类型
  selectAnalysisType(e) {
    const type = e.currentTarget.dataset.type;
    
    const updatedOptions = this.data.analysisOptions.map(option => ({
      ...option,
      selected: option.id === type
    }));
    
    this.setData({
      analysisType: type,
      analysisOptions: updatedOptions,
      estimatedTime: this.getEstimatedTime(type)
    });
    
    wx.showToast({
      title: `已选择: ${this.getTypeName(type)}`,
      icon: 'success'
    });
  },
  
  getTypeName(type) {
    const names = {
      'auto': '自动分析',
      'manual': '手动设置',
      'quick': '快速分析'
    };
    return names[type] || '未知类型';
  },
  
  getEstimatedTime(type) {
    const times = {
      'auto': '约3分钟',
      'manual': '约5分钟',
      'quick': '约1分钟'
    };
    return times[type] || '约3分钟';
  },
  
  // 开始分析
  startRealTimeAnalysis() {
    console.log('开始分析，类型:', this.data.analysisType);
    
    this.setData({
      analysisStatus: 'analyzing',
      progress: 0
    });
    
    wx.showToast({
      title: '开始采集数据',
      icon: 'success'
    });
    
    // 开始模拟分析
    this.simulateAnalysis();
    
    // 开始实时数据更新
    this.startRealTimeUpdates();
  },
  
  // 模拟分析过程
  simulateAnalysis() {
    let progress = 0;
    const interval = setInterval(() => {
      progress += 2; // 更慢的进度，更真实
      
      this.setData({
        progress: progress
      });
      
      if (progress >= 100) {
        clearInterval(interval);
        this.analysisComplete();
      }
    }, 200);
    
    this.analysisInterval = interval;
  },
  
  // 实时数据更新
  startRealTimeUpdates() {
    this.realTimeInterval = setInterval(() => {
      const newData = {
        heartRate: 65 + Math.floor(Math.random() * 20), // 65-85
        breathingRate: 14 + Math.floor(Math.random() * 6), // 14-20
        movement: ['静止', '轻微', '中等'][Math.floor(Math.random() * 3)],
        noiseLevel: ['安静', '轻微', '中等'][Math.floor(Math.random() * 3)],
        lightLevel: ['黑暗', '微光', '明亮'][Math.floor(Math.random() * 3)]
      };
      
      this.setData({
        realTimeData: newData
      });
    }, 3000);
  },
  
  // 分析完成
  analysisComplete() {
    clearInterval(this.realTimeInterval);
    
    this.setData({
      analysisStatus: 'completed',
      progress: 100
    });
    
    // 生成分析结果
    const analysisResult = {
      id: Date.now(),
      time: new Date().toLocaleString(),
      score: 75 + Math.floor(Math.random() * 20), // 75-95
      duration: `${6 + Math.floor(Math.random() * 3)}h ${Math.floor(Math.random() * 60)}m`,
      type: this.getTypeName(this.data.analysisType),
      details: {
        deepSleep: `${1 + Math.random() * 2}h`,
        remSleep: `${1 + Math.random() * 1.5}h`,
        awakeTimes: Math.floor(Math.random() * 5),
        sleepEfficiency: 80 + Math.floor(Math.random() * 15)
      }
    };
    
    // 保存到历史
    this.saveAnalysisResult(analysisResult);
    
    wx.showToast({
      title: '分析完成！',
      icon: 'success',
      duration: 2000
    });
    
    // 2秒后跳转到报告页面，并传递结果
    setTimeout(() => {
      wx.navigateTo({
        url: `/pages/report/report?result=${encodeURIComponent(JSON.stringify(analysisResult))}`
      });
    }, 2000);
  },
  
  // 保存分析结果
  saveAnalysisResult(result) {
    let history = wx.getStorageSync('analysis_history') || [];
    history.unshift(result); // 添加到开头
    if (history.length > 50) history = history.slice(0, 50); // 最多保存50条
    
    wx.setStorageSync('analysis_history', history);
    
    // 更新显示
    this.setData({
      recentAnalyses: history.slice(0, 3)
    });
  },
  
  // 查看历史详情
  viewAnalysisDetail(e) {
    const index = e.currentTarget.dataset.index;
    const analysis = this.data.recentAnalyses[index];
    
    if (analysis) {
      wx.showModal({
        title: `分析详情 - ${analysis.time}`,
        content: `评分: ${analysis.score}分\n时长: ${analysis.duration}\n类型: ${analysis.type}`,
        showCancel: false,
        confirmText: '查看完整报告'
      });
    }
  },
  
  // 手动设置调整
  updateManualSetting(e) {
    const { key, value } = e.currentTarget.dataset;
    
    this.setData({
      [`manualSettings.${key}`]: value
    });
    
    console.log('设置更新:', key, '=', value);
  },
  
  // 打开手动设置面板
  openManualSettings() {
    this.setData({
      showManualPanel: true
    });
  },
  
  // 关闭手动设置面板
  closeManualSettings() {
    this.setData({
      showManualPanel: false
    });
  },
  
  // 保存手动设置
  saveManualSettings() {
    wx.showToast({
      title: '设置已保存',
      icon: 'success'
    });
    
    this.closeManualSettings();
  },
  
  // 处理导航点击
  handleNavClick(e) {
    const page = e.currentTarget.dataset.page;
    if (page) {
      this.navigateToPage(page);
    }
  },
  
  // 安全的页面跳转
  navigateToPage(pageName) {
    console.log('跳转到页面:', pageName);
    
    if (pageName === 'report') {
      wx.navigateTo({
        url: '/pages/report/report'
      });
    } else if (pageName === 'history') {
      wx.navigateTo({
        url: '/pages/history/history'
      });
    } else if (pageName === 'meditation') {
      wx.navigateTo({
        url: '/pages/meditation/meditation'
      });
    } else if (pageName === 'settings') {
      wx.navigateTo({
        url: '/pages/settings/settings'
      });
    }
  },
  
  goToHome() {
    wx.switchTab({
      url: '/pages/index/index'
    });
  },
  
  onUnload() {
    // 清理所有定时器
    if (this.analysisInterval) {
      clearInterval(this.analysisInterval);
    }
    if (this.realTimeInterval) {
      clearInterval(this.realTimeInterval);
    }
  }
});