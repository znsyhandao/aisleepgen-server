.page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at center, #0d0d2b 0%, #030312 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

/* 全息网格背景 */
.hologrid {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background-image: 
    linear-gradient(rgba(72, 219, 251, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(72, 219, 251, 0.03) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  perspective: 1000px;
  transform: rotateX(60deg);
  transform-origin: center top;
  pointer-events: none;
  z-index: 0;
}

.close {
  position: absolute;
  top: 80rpx; right: 40rpx;
  width: 60rpx; height: 60rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}
.close-icon {
  font-size: 36rpx;
  color: rgba(255,255,255,0.25);
}

.title-bar {
  position: absolute;
  top: 80rpx;
  z-index: 10;
}
.title-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 6rpx;
  font-weight: 300;
}

/* 全息人体 */
.body-area {
  position: relative;
  width: 400rpx;
  height: 500rpx;
  margin-top: 140rpx;
  z-index: 2;
}

.hologram-body {
  position: relative;
  width: 100%;
  height: 100%;
}

/* 人体部位（用块状勾勒） */
.body-part {
  position: absolute;
  border: 1rpx solid rgba(72, 219, 251, 0.08);
  border-radius: 4rpx;
  background: rgba(72, 219, 251, 0.02);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
.body-part.active {
  border-color: rgba(150, 220, 255, 0.5);
  background: rgba(72, 219, 251, 0.08);
  box-shadow: 0 0 30rpx rgba(72, 219, 251, 0.1), inset 0 0 20rpx rgba(72, 219, 251, 0.05);
}

.part-glow {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  border-radius: 4rpx;
  opacity: 0;
  transition: opacity 0.6s ease;
}
.body-part.active .part-glow {
  opacity: 1;
  background: radial-gradient(ellipse, rgba(72, 219, 251, 0.06) 0%, transparent 70%);
}

/* 头部 */
.body-part.head {
  top: 0;
  left: 50%;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  transform: translateX(-50%);
}

/* 躯干 */
.body-part.torso {
  top: 90rpx;
  left: 50%;
  width: 160rpx;
  height: 200rpx;
  transform: translateX(-50%);
  border-radius: 8rpx;
}

/* 左臂 */
.body-part.arm-left {
  top: 100rpx;
  left: 20rpx;
  width: 50rpx;
  height: 180rpx;
  border-radius: 25rpx;
}

/* 右臂 */
.body-part.arm-right {
  top: 100rpx;
  right: 20rpx;
  width: 50rpx;
  height: 180rpx;
  border-radius: 25rpx;
}

/* 左腿 */
.body-part.leg-left {
  top: 300rpx;
  left: 80rpx;
  width: 60rpx;
  height: 200rpx;
  border-radius: 30rpx;
}

/* 右腿 */
.body-part.leg-right {
  top: 300rpx;
  right: 80rpx;
  width: 60rpx;
  height: 200rpx;
  border-radius: 30rpx;
}

/* 扫描线 */
.scan-line {
  position: absolute;
  left: -20rpx; right: -20rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(72, 219, 251, 0.3), transparent);
  animation: scan 3s ease-in-out infinite;
  z-index: 3;
}
@keyframes scan {
  0% { top: 0; opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

/* 进度条 */
.progress-wrap {
  position: absolute;
  top: 660rpx;
  left: 60rpx; right: 60rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 5;
}
.progress-track {
  flex: 1;
  height: 2rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 2rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(72, 219, 251, 0.4), rgba(150, 220, 255, 0.6));
  border-radius: 2rpx;
  transition: width 0.5s ease;
}
.progress-num {
  font-size: 20rpx;
  color: rgba(255,255,255,0.25);
  width: 80rpx;
  text-align: right;
}

/* 指令卡片 */
.instruction-card {
  position: absolute;
  bottom: 200rpx;
  left: 40rpx; right: 40rpx;
  background: rgba(255,255,255,0.02);
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
  backdrop-filter: blur(10px);
}

.part-badge {
  margin-bottom: 16rpx;
}
.badge-text {
  font-size: 24rpx;
  color: rgba(72, 219, 251, 0.6);
  letter-spacing: 4rpx;
}

.phase-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.instruction-text {
  font-size: 30rpx;
  color: rgba(255,255,255,0.7);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
  min-height: 80rpx;
}
.instruction-text.action {
  color: rgba(150, 220, 255, 0.8);
}
.instruction-text.release {
  color: rgba(200, 180, 255, 0.6);
}

.phases-status {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.status-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  margin-bottom: 16rpx;
}

/* 倒计时光环 */
.countdown-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(72, 219, 251, 0.2);
  background: rgba(72, 219, 251, 0.03);
}
.countdown-ring.relax {
  border-color: rgba(200, 180, 255, 0.2);
  background: rgba(200, 180, 255, 0.03);
}
.countdown-num {
  font-size: 48rpx;
  color: rgba(255,255,255,0.8);
  font-weight: 200;
  font-variant-numeric: tabular-nums;
}
.countdown-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.3);
  letter-spacing: 2rpx;
}

/* 完成 */
.done-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}
.done-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.done-title {
  font-size: 36rpx;
  color: rgba(255,255,255,0.8);
  font-weight: 300;
  margin-bottom: 10rpx;
}
.done-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.35);
  margin-bottom: 30rpx;
}
.done-btn {
  padding: 20rpx 80rpx;
  border: 1rpx solid rgba(72, 219, 251, 0.15);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: rgba(72, 219, 251, 0.5);
  background: rgba(72, 219, 251, 0.03);
}

.tip-bar {
  position: absolute;
  bottom: 120rpx;
  z-index: 5;
}
.tip-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.2);
  letter-spacing: 2rpx;
}
