/* pages/privacy/privacy.wxss */
.container {
  min-height: 100vh;
  background: #0f3460;
  padding-top: 20rpx;
}

.tabs {
  display: flex;
  margin: 0 30rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  transition: all 0.3s;
}

.tab.active {
  color: #4A90E2;
  background: rgba(74,144,226,0.15);
  font-weight: bold;
}

.content {
  padding: 30rpx;
  height: calc(100vh - 120rpx);
}

.section {
  padding-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.update {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  margin-bottom: 40rpx;
}

.subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #4A90E2;
  margin: 30rpx 0 16rpx;
}

.text {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.8;
}
