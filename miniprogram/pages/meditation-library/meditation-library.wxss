/* pages/meditation-library/meditation-library.wxss — 冥想库样式 */
page { background: #0f0f23; min-height: 100vh; }

.container { padding: 0 24rpx 40rpx; }

/* header */
.header {
  display: flex;
  align-items: center;
  padding: 30rpx 0 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e0d8f0;
  flex: 1;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #888;
}

/* tags */
.tag-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 12rpx 0 20rpx;
  white-space: nowrap;
}

.tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #888;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  flex-shrink: 0;
}

.tag.active {
  color: #e0d8f0;
  background: rgba(102,126,234,0.15);
  border-color: rgba(102,126,234,0.4);
}

/* series grid */
.series-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.series-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 28rpx;
  transition: all 0.15s;
}

.series-card:active {
  background: rgba(255,255,255,0.08);
  transform: scale(0.99);
}

.series-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.series-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0d8f0;
}

.series-count {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102,126,234,0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.series-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.series-ambient {
  font-size: 22rpx;
  color: #666;
  margin-top: 10rpx;
}

/* item list in series detail */
.detail-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  gap: 16rpx;
}

.detail-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #888;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e0d8f0;
  flex: 1;
}

.detail-ambient {
  font-size: 22rpx;
  color: #667eea;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16rpx;
}

.item-card:active {
  background: rgba(102,126,234,0.08);
}

.item-title {
  font-size: 26rpx;
  color: #ccc;
  flex: 1;
}

.item-duration {
  font-size: 22rpx;
  color: #888;
  margin-left: 12rpx;
}

.item-play {
  font-size: 32rpx;
  color: #667eea;
  margin-left: 16rpx;
}

/* loading */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.08);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #888;
  margin-top: 16rpx;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* log */
.log-area {
  background: rgba(0,0,0,0.3);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 30rpx;
  max-height: 160rpx;
  overflow-y: auto;
}

.log-line {
  font-size: 20rpx;
  color: #444;
  font-family: monospace;
  display: block;
  line-height: 1.6;
}
