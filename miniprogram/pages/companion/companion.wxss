/* companion.wxss — 陪伴模式页面 */
page {
  background: #0a0a1a;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", sans-serif;
  overflow: hidden;
}

.page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at center, #0f0f2e 0%, #0a0a1a 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 全息背景 */
.holographic-bg {
  position: fixed;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: 
    radial-gradient(circle at 30% 40%, rgba(102,126,234,0.03) 0%, transparent 50%),
    radial-gradient(circle at 70% 60%, rgba(118,75,162,0.03) 0%, transparent 50%);
  animation: holoShift 8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes holoShift {
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(2deg); }
}

/* 粒子层 */
.particle-layer {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}

/* 顶部栏 */
.top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 80rpx 30rpx 20rpx;
  z-index: 10;
}

.protocol-label {
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.top-actions {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.sound-toggle, .close-btn {
  width: 60rpx; height: 60rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.08);
}

.sound-icon, .close-icon {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
}

/* ===== 呼吸动画 ===== */
.center-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.breath-circle-wrap {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breath-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(102,126,234,0.25), rgba(72,75,162,0.1));
  transition: transform 0.3s ease-out;
  position: absolute;
}

.breath-circle.inhale {
  transform: scale(1.3) !important;
  box-shadow: 0 0 60rpx rgba(102,126,234,0.15);
}

.breath-circle.hold {
  transform: scale(1.3) !important;
}

.breath-circle.exhale {
  transform: scale(0.85) !important;
}

.breath-glow {
  position: absolute;
  top: -20%; left: -20%;
  width: 140%; height: 140%;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.5s;
}

.breath-glow.inhale {
  opacity: 0.3;
  background: radial-gradient(circle, rgba(102,126,234,0.2), transparent);
}

.breath-glow.exhale {
  opacity: 0.1;
  background: radial-gradient(circle, rgba(72,219,251,0.15), transparent);
}

.breath-phase-text {
  position: absolute;
  color: rgba(255,255,255,0.6);
  font-size: 32rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
  z-index: 2;
}

.breath-count-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 40rpx);
  color: rgba(255,255,255,0.2);
  font-size: 72rpx;
  font-weight: 100;
  z-index: 1;
}

/* ===== 扫描区域 ===== */
.scan-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.scan-ring {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(102,126,234,0.15);
  animation: scanPulse 3s ease-in-out infinite;
}

@keyframes scanPulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.1); opacity: 0.6; }
}

.scan-body {
  width: 200rpx;
  height: 300rpx;
  position: relative;
}

.body-part {
  width: 100%;
  height: 100%;
  border-radius: 60rpx 60rpx 30rpx 30rpx;
  background: rgba(255,255,255,0.02);
  border: 1rpx solid rgba(255,255,255,0.06);
  transition: all 0.5s;
}

.body-part.active {
  background: rgba(102,126,234,0.08);
  border-color: rgba(102,126,234,0.2);
  box-shadow: 0 0 30rpx rgba(102,126,234,0.1);
}

.scan-text {
  color: rgba(255,255,255,0.65);
  font-size: 28rpx;
  text-align: center;
  max-width: 80%;
  line-height: 1.6;
}

/* ===== 监测区域 ===== */
.monitor-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

.monitor-pulse {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102,126,234,0.05), transparent);
}

.monitor-pulse.pulse {
  animation: monitorBeat 2s ease-in-out infinite;
}

@keyframes monitorBeat {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

.monitor-text {
  color: rgba(255,255,255,0.45);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.monitor-hint {
  color: rgba(255,255,255,0.2);
  font-size: 22rpx;
}

/* ===== 渐弱退出 ===== */
.release-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.release-wave {
  width: 300rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(102,126,234,0.4), transparent);
  animation: waveFade 2s ease-in-out infinite;
}

@keyframes waveFade {
  0% { transform: scaleX(0.5); opacity: 0; }
  50% { transform: scaleX(1); opacity: 1; }
  100% { transform: scaleX(0.5); opacity: 0; }
}

.release-text {
  color: rgba(255,255,255,0.3);
  font-size: 24rpx;
  animation: textFade 1s ease-in-out infinite alternate;
}

@keyframes textFade {
  0% { opacity: 0.2; }
  100% { opacity: 0.5; }
}

/* ===== 完成 ===== */
.done-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.done-icon {
  font-size: 100rpx;
  animation: floatGlow 3s ease-in-out infinite;
}

@keyframes floatGlow {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-10rpx) scale(1.05); }
}

.done-text {
  color: rgba(255,255,255,0.5);
  font-size: 28rpx;
  letter-spacing: 6rpx;
}

.done-sub {
  color: rgba(255,255,255,0.2);
  font-size: 22rpx;
}

/* ===== 底部 ===== */
.bottom-bar {
  position: fixed;
  bottom: 80rpx;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  padding: 0 60rpx;
  z-index: 10;
}

.bottom-btn {
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 40rpx;
  padding: 20rpx 50rpx;
  color: rgba(255,255,255,0.35);
  font-size: 26rpx;
  transition: all 0.3s;
}

.bottom-btn.primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border: none;
  color: #fff;
  padding: 22rpx 60rpx;
}

