// pages/history/history.js
Page({
  data: {
    // 筛选条件
    filters: {
      dateRange: 'week', // week, month, year, all
      minScore: 0,
      maxScore: 100,
      quality: 'all', // all, excellent, good, average, poor
      sortBy: 'date', // date, score, duration
      sortOrder: 'desc' // asc, desc
    },
    
    // 历史记录
    historyRecords: [],
    
    // 统计数据
    stats: {
      totalRecords: 0,
      averageScore: 0,
      bestScore: 0,
      worstScore: 100,
      totalDuration: 0,
      consistency: 0
    },
    
    // 图表数据
    chartData: {
      dates: [],
      scores: [],
      durations: []
    },
    
    // 加载状态
    loading: false,
    hasMore: true,
    page: 1,
    pageSize: 20
  },

  onLoad() {
    // 加载历史记录
    this.loadHistoryRecords()
    
    // 计算统计数据
    this.calculateStats()
  },

  onShow() {
    // 页面显示时刷新数据
    this.loadHistoryRecords()
  },

  loadHistoryRecords() {
    this.setData({ loading: true })
    
    // 从本地存储加载历史记录
    const allRecords = wx.getStorageSync('sleep_history') || []
    
    // 应用筛选条件
    let filteredRecords = this.applyFilters(allRecords)
    
    // 应用排序
    filteredRecords = this.applySorting(filteredRecords)
    
    // 分页
    const startIndex = (this.data.page - 1) * this.data.pageSize
    const endIndex = startIndex + this.data.pageSize
    const pagedRecords = filteredRecords.slice(startIndex, endIndex)
    
    // 更新数据
    this.setData({
      historyRecords: pagedRecords,
      loading: false,
      hasMore: endIndex < filteredRecords.length
    })
    
    // 更新图表数据
    this.updateChartData(filteredRecords)
  },

  applyFilters(records) {
    const { dateRange, minScore, maxScore, quality } = this.data.filters
    
    return records.filter(record => {
      // 日期范围筛选
      if (dateRange !== 'all') {
        const recordDate = new Date(record.date)
        const now = new Date()
        let startDate
        
        switch(dateRange) {
          case 'week':
            startDate = new Date(now.setDate(now.getDate() - 7))
            break
          case 'month':
            startDate = new Date(now.setMonth(now.getMonth() - 1))
            break
          case 'year':
            startDate = new Date(now.setFullYear(now.getFullYear() - 1))
            break
        }
        
        if (recordDate < startDate) {
          return false
        }
      }
      
      // 分数范围筛选
      if (record.score < minScore || record.score > maxScore) {
        return false
      }
      
      // 质量筛选
      if (quality !== 'all') {
        const recordQuality = this.getQualityLevel(record.score)
        if (recordQuality !== quality) {
          return false
        }
      }
      
      return true
    })
  },

  applySorting(records) {
    const { sortBy, sortOrder } = this.data.filters
    
    return records.sort((a, b) => {
      let comparison = 0
      
      switch(sortBy) {
        case 'date':
          comparison = new Date(b.date) - new Date(a.date)
          break
        case 'score':
          comparison = b.score - a.score
          break
        case 'duration':
          const durationA = this.parseDuration(a.duration)
          const durationB = this.parseDuration(b.duration)
          comparison = durationB - durationA
          break
      }
      
      return sortOrder === 'asc' ? -comparison : comparison
    })
  },

  parseDuration(durationStr) {
    // 解析 "7h 30m" 格式的时长
    const match = durationStr.match(/(\d+)h\s*(\d+)m/)
    if (match) {
      return parseInt(match[1]) * 60 + parseInt(match[2])
    }
    return 0
  },

  getQualityLevel(score) {
    if (score >= 85) return 'excellent'
    if (score >= 75) return 'good'
    if (score >= 65) return 'average'
    return 'poor'
  },

  calculateStats() {
    const allRecords = wx.getStorageSync('sleep_history') || []
    
    if (allRecords.length === 0) {
      return
    }
    
    let totalScore = 0
    let totalDuration = 0
    let bestScore = 0
    let worstScore = 100
    
    allRecords.forEach(record => {
      totalScore += record.score
      totalDuration += this.parseDuration(record.duration)
      bestScore = Math.max(bestScore, record.score)
      worstScore = Math.min(worstScore, record.score)
    })
    
    // 计算一致性（分数标准差）
    const averageScore = totalScore / allRecords.length
    let variance = 0
    allRecords.forEach(record => {
      variance += Math.pow(record.score - averageScore, 2)
    })
    const stdDev = Math.sqrt(variance / allRecords.length)
    const consistency = Math.max(0, 100 - stdDev * 2) // 简单的一致性计算
    
    this.setData({
      stats: {
        totalRecords: allRecords.length,
        averageScore: Math.round(averageScore),
        bestScore,
        worstScore,
        totalDuration: Math.round(totalDuration / 60), // 转换为小时
        consistency: Math.round(consistency)
      }
    })
  },

  updateChartData(records) {
    // 取最近30条记录用于图表
    const recentRecords = records.slice(0, 30)
    
    const dates = recentRecords.map(r => r.date)
    const scores = recentRecords.map(r => r.score)
    const durations = recentRecords.map(r => this.parseDuration(r.duration) / 60) // 转换为小时
    
    this.setData({
      chartData: { dates, scores, durations }
    })
  },

  updateFilter(e) {
    const { key, value } = e.currentTarget.dataset
    this.setData({
      [`filters.${key}`]: value
    })
    
    // 重新加载数据
    this.setData({ page: 1 })
    this.loadHistoryRecords()
    this.calculateStats()
  },

  viewRecordDetail(e) {
    const index = e.currentTarget.dataset.index
    const record = this.data.historyRecords[index]
    
    if (record) {
      wx.navigateTo({
        url: `/pages/report/report?date=${record.date}`
      })
    }
  },

  deleteRecord(e) {
    const index = e.currentTarget.dataset.index
    const record = this.data.historyRecords[index]
    
    if (!record) return
    
    wx.showModal({
      title: '删除记录',
      content: `确定要删除 ${record.date} 的记录吗？`,
      success: (res) => {
        if (res.confirm) {
          this.confirmDeleteRecord(record.date)
        }
      }
    })
  },

  confirmDeleteRecord(date) {
    // 从本地存储删除
    const allRecords = wx.getStorageSync('sleep_history') || []
    const updatedRecords = allRecords.filter(r => r.date !== date)
    
    wx.setStorageSync('sleep_history', updatedRecords)
    
    // 重新加载数据
    this.loadHistoryRecords()
    this.calculateStats()
    
    wx.showToast({
      title: '记录已删除',
      icon: 'success'
    })
  },

  deleteAllRecords() {
    wx.showModal({
      title: '删除所有记录',
      content: '确定要删除所有历史记录吗？此操作不可恢复。',
      confirmText: '删除全部',
      confirmColor: '#ff6b6b',
      success: (res) => {
        if (res.confirm) {
          this.confirmDeleteAllRecords()
        }
      }
    })
  },

  confirmDeleteAllRecords() {
    wx.removeStorageSync('sleep_history')
    
    this.setData({
      historyRecords: [],
      stats: {
        totalRecords: 0,
        averageScore: 0,
        bestScore: 0,
        worstScore: 100,
        totalDuration: 0,
        consistency: 0
      },
      chartData: {
        dates: [],
        scores: [],
        durations: []
      }
    })
    
    wx.showToast({
      title: '所有记录已删除',
      icon: 'success'
    })
  },

  exportHistory() {
    wx.showActionSheet({
      itemList: ['导出为Excel', '导出为JSON', '导出为PDF报告'],
      success: (res) => {
        const formats = ['excel', 'json', 'pdf']
        this.handleExport(formats[res.tapIndex])
      }
    })
  },

  handleExport(format) {
    wx.showLoading({
      title: '准备数据...'
    })
    
    setTimeout(() => {
      wx.hideLoading()
      
      // 模拟文件生成
      const allRecords = wx.getStorageSync('sleep_history') || []
      const dataStr = JSON.stringify(allRecords, null, 2)
      
      wx.saveFile({
        tempFilePath: `${wx.env.USER_DATA_PATH}/sleep_history.${format}`,
        success: (res) => {
          wx.showToast({
            title: '导出成功',
            icon: 'success'
          })
          
          // 分享文件
          wx.shareFileMessage({
            filePath: res.savedFilePath,
            success: () => {
              console.log('文件分享成功')
            }
          })
        }
      })
    }, 2000)
  },

  loadMore() {
    if (this.data.loading || !this.data.hasMore) {
      return
    }
    
    this.setData({
      page: this.data.page + 1
    })
    
    this.loadHistoryRecords()
  },

  refreshData() {
    this.setData({
      page: 1,
      historyRecords: []
    })
    
    this.loadHistoryRecords()
    this.calculateStats()
    
    wx.showToast({
      title: '数据已刷新',
      icon: 'success'
    })
  },

  viewStatsDetail() {
    const stats = this.data.stats
    
    wx.showModal({
      title: '详细统计',
      content: `总记录数: ${stats.totalRecords}条\n平均评分: ${stats.averageScore}分\n最佳评分: ${stats.bestScore}分\n最差评分: ${stats.worstScore}分\n总睡眠时长: ${stats.totalDuration}小时\n睡眠一致性: ${stats.consistency}%`,
      showCancel: false
    })
  },

  comparePeriods() {
    wx.showActionSheet({
      itemList: ['本周 vs 上周', '本月 vs 上月', '自定义对比'],
      success: (res) => {
        if (res.tapIndex === 0) {
          this.compareWeekOverWeek()
        } else if (res.tapIndex === 1) {
          this.compareMonthOverMonth()
        } else {
          this.customCompare()
        }
      }
    })
  },

  compareWeekOverWeek() {
    const allRecords = wx.getStorageSync('sleep_history') || []
    const now = new Date()
    
    // 本周数据
    const weekStart = new Date(now.setDate(now.getDate() - now.getDay()))
    const weekRecords = allRecords.filter(r => new Date(r.date) >= weekStart)
    
    // 上周数据
    const lastWeekStart = new Date(weekStart)
    lastWeekStart.setDate(lastWeekStart.getDate() - 7)
    const lastWeekEnd = new Date(weekStart)
    lastWeekEnd.setDate(lastWeekEnd.getDate() - 1)
    const lastWeekRecords = allRecords.filter(r => {
      const date = new Date(r.date)
      return date >= lastWeekStart && date <= lastWeekEnd
    })
    
    this.showComparison(weekRecords, lastWeekRecords, '本周', '上周')
  },

  compareMonthOverMonth() {
    const allRecords = wx.getStorageSync('sleep_history') || []
    const now = new Date()
    
    // 本月数据
    const monthStart = new Date(now.getFullYear(), now.getMonth(), 1)
    const monthRecords = allRecords.filter(r => new Date(r.date) >= monthStart)
    
    // 上月数据
    const lastMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1)
    const lastMonthEnd = new Date(now.getFullYear(), now.getMonth(), 0)
    const lastMonthRecords = allRecords.filter(r => {
      const date = new Date(r.date)
      return date >= lastMonthStart && date <= lastMonthEnd
    })
    
    this.showComparison(monthRecords, lastMonthRecords, '本月', '上月')
  },

  showComparison(currentRecords, previousRecords, currentLabel, previousLabel) {
    const currentAvg = this.calculateAverage(currentRecords)
    const previousAvg = this.calculateAverage(previousRecords)
    const diff = currentAvg - previousAvg
    
    let message = `${currentLabel}平均分: ${currentAvg.toFixed(1)}分\n`
    message += `${previousLabel}平均分: ${previousAvg.toFixed(1)}分\n`
    message += `变化: ${diff >= 0 ? '+' : ''}${diff.toFixed(1)}分\n`
    message += diff > 0 ? '👍 睡眠质量有所提升！' : 
               diff < 0 ? '📉 睡眠质量有所下降' : 
               '➡️ 睡眠质量保持稳定'
    
    wx.showModal({
      title: '对比分析',
      content: message,
      showCancel: false
    })
  },

  calculateAverage(records) {
    if (records.length === 0) return 0
    const total = records.reduce((sum, r) => sum + r.score, 0)
    return total / records.length
  },

  customCompare() {
    wx.navigateTo({
      url: '/pages/history/compare'
    })
  },

  setGoal() {
    wx.navigateTo({
      url: '/pages/settings/goal'
    })
  },

  shareHistory() {
    const stats = this.data.stats
    
    wx.showShareMenu({
      withShareTicket: true
    })
  },

  onShareAppMessage() {
    const stats = this.data.stats
    return {
      title: `我的睡眠历史 - 平均${stats.averageScore}分`,
      path: '/pages/history/history',
      imageUrl: '/images/history-share.png'
    }
  },

  viewTrendAnalysis() {
    wx.navigateTo({
      url: '/pages/history/trend'
    })
  },

  searchRecords(e) {
    const keyword = e.detail.value.toLowerCase()
    
    if (!keyword) {
      this.loadHistoryRecords()
      return
    }
    
    const allRecords = wx.getStorageSync('sleep_history') || []
    const filtered = allRecords.filter(r => 
      r.date.includes(keyword) || 
      r.quality.toLowerCase().includes(keyword)
    )
    
    this.setData({
      historyRecords: filtered.slice(0, this.data.pageSize)
    })
  }
})