  padding: 12rpx 16rpx;
  margin: 10rpx 0 4rpx 0;
}
.insight-banner-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.insight-banner-text {
  font-size: 24rpx;
  color: #e0b860;
  line-height: 1.4;
}
.rag-hint {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
