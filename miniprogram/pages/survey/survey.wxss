/* pages/survey/survey.wxss — 三步睡眠记录向导 */
page {
  background: #0f0f23;
  min-height: 100vh;
}
.page {
  padding: 80rpx 40rpx 40rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 返回按钮 ===== */
.back-btn {
  position: fixed;
  top: 40rpx;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.back-icon {
  font-size: 40rpx;
  color: rgba(255,255,255,0.6);
}

/* ===== 进度条 ===== */
.progress-bar {
  width: 100%;
  height: 4rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 2rpx;
  margin-bottom: 16rpx;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #6FCF97);
  border-radius: 2rpx;
  transition: width 0.3s;
}
.step-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 80rpx;
  gap: 0;
}
.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-dot.active {
  background: #4A90E2;
}
.dot-num {
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
}
.step-line {
  width: 80rpx;
  height: 3rpx;
  background: rgba(255,255,255,0.08);
}
.step-line.active {
  background: #4A90E2;
}

/* ===== 问题区域 ===== */
.question-area {
  text-align: center;
  margin-bottom: 60rpx;
}
.q-number {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: bold;
}
.q-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-top: 12rpx;
  display: block;
}
.q-title.small {
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
.q-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 8rpx;
  display: block;
}

/* ===== 选项网格 ===== */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
  margin-bottom: 60rpx;
}
.option-grid.narrow {
  max-width: 500rpx;
  margin: 0 auto 60rpx;
}
.option-grid.three {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  max-width: 600rpx;
  margin: 0 auto;
}
.option-btn {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.option-grid.narrow .option-btn {
  width: 200rpx;
}
.option-grid.three .option-btn {
  width: auto;
  height: 100rpx;
}
.option-btn.selected {
  background: rgba(74,144,226,0.15);
  border-color: #4A90E2;
}
.option-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.option-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  text-align: center;
}
.option-btn.selected .option-text {
  color: #4A90E2;
  font-weight: bold;
}

/* ===== 子问题 ===== */
.sub-question {
  margin-top: 40rpx;
}

/* ===== 导航按钮 ===== */
.nav-row {
  display: flex;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 40rpx;
}
.nav-btn {
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.06);
}
.nav-btn.primary {
  background: linear-gradient(135deg, #4A90E2, #2D9CDB);
  color: #fff;
  font-weight: bold;
}
.nav-btn.disabled {
  opacity: 0.3;
}

/* ===== 加载 ===== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,15,35,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(74,144,226,0.2);
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 24rpx;
}

