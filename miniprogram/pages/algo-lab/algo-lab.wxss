/* pages/algo-lab/algo-lab.wxss - AI 算法实验室 */
.page {
  min-height: 100vh;
  background: #0f0f23;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.header {
  padding: 40rpx 32rpx 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #e0d8f0;
}

.header-sub {
  font-size: 24rpx;
  color: #888;
  margin-top: 10rpx;
  line-height: 1.5;
}

.section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #aaa;
  margin: 20rpx 8rpx 16rpx;
}

.algo-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.algo-card.featured {
  border-color: rgba(102, 126, 234, 0.5);
  background: rgba(102, 126, 234, 0.08);
}

.algo-name {
  font-size: 28rpx;
  color: #e0d8f0;
  font-weight: 600;
  word-break: break-all;
}

.algo-meta {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  word-break: break-all;
}

.run-hint {
  font-size: 22rpx;
  color: #667eea;
  margin-top: 10rpx;
}

.search-box {
  padding: 0 32rpx 10rpx;
}

.search-input {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #e0d8f0;
}

.loading {
  text-align: center;
  color: #666;
  padding: 40rpx 0;
  font-size: 26rpx;
}

.load-more {
  text-align: center;
  color: #667eea;
  padding: 20rpx 0;
  font-size: 26rpx;
}

/* 运行结果弹层 */
.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-panel {
  width: 88%;
  max-height: 80vh;
  background: #1a1a35;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.result-title {
  font-size: 28rpx;
  color: #e0d8f0;
  font-weight: 600;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.result-interpret {
  font-size: 26rpx;
  color: #7ee0a0;
  line-height: 1.6;
  padding: 16rpx;
  background: rgba(126, 224, 160, 0.08);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.result-body {
  max-height: 50vh;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12rpx;
  padding: 16rpx;
}

.result-json {
  font-size: 22rpx;
  color: #9aa0c0;
  font-family: monospace;
  word-break: break-all;
  white-space: pre-wrap;
}

.result-error {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-top: 16rpx;
}

.result-close {
  margin-top: 24rpx;
  text-align: center;
  color: #667eea;
  font-size: 28rpx;
  padding: 16rpx;
  border: 1px solid rgba(102, 126, 234, 0.4);
  border-radius: 40rpx;
}
