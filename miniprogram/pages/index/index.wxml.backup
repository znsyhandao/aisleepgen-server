<!--pages/index/index.wxml-->
<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
    <text class="subtitle">{{subtitle}}</text>
  </view>
  
  <view class="content">
    <view class="card">
      <text class="card-title">今日睡眠概览</text>
      <view class="stats">
        <view class="stat">
          <text class="stat-value">85</text>
          <text class="stat-label">睡眠评分</text>
        </view>
        <view class="stat">
          <text class="stat-value">7h 30m</text>
          <text class="stat-label">睡眠时长</text>
        </view>
      </view>
    </view>
    
    <button class="primary-btn" bindtap="startAnalysis" wx:if="{{canStart}}">
      开始睡眠分析
    </button>
    
    <button class="secondary-btn" bindtap="viewHistory">
      查看历史记录
    </button>
  </view>
</view>
