/* 睡眠录音页面样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f23 0%, #1a1a3e 100%);
  padding: 20rpx 30rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 空闲状态 ===== */
.idle-state, .recording-state, .done-state, .analyzing-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding-top: 80rpx;
}

.moon-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.title-tip {
  font-size: 32rpx;
  color: #e0e0e0;
  text-align: center;
  margin-bottom: 40rpx;
}

/* 小贴士卡片 */
.tips-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 24rpx;
  padding: 30rpx;
  width: 85%;
  margin-bottom: 60rpx;
}

.tips-title {
  font-size: 28rpx;
  color: #a0c4ff;
  display: block;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.tips-item {
  font-size: 24rpx;
  color: #888;
  display: block;
  line-height: 1.8;
}

/* 大按钮 */
.start-btn {
  width: 80%;
  height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 226, 0.3);
}

.start-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}

/* ===== 录音中 ===== */
.record-animation {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.pulse-ring {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 68, 68, 0.15);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0.3; }
  50% { transform: scale(1.2); opacity: 0.1; }
  100% { transform: scale(0.8); opacity: 0.3; }
}

.mic-icon {
  font-size: 80rpx;
  z-index: 1;
  animation: mic-bounce 0.5s ease-in-out infinite alternate;
}

@keyframes mic-bounce {
  from { transform: scale(1); }
  to { transform: scale(1.1); }
}

.duration-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 10rpx;
  font-variant-numeric: tabular-nums;
}

.recording-hint {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 60rpx;
}

.stop-btn {
  width: 60%;
  height: 90rpx;
  border-radius: 45rpx;
  background: rgba(255, 68, 68, 0.15);
  color: #ff4444;
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255, 68, 68, 0.3);
}

/* ===== 录音完成 ===== */
.done-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  width: 100%;
  justify-content: center;
}

.primary-btn {
  padding: 24rpx 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #4A90E2, #357ABD);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  min-width: 200rpx;
  text-align: center;
}

.secondary-btn {
  padding: 24rpx 48rpx;
  border-radius: 40rpx;
  background: transparent;
  color: #888;
  font-size: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.15);
  min-width: 200rpx;
  text-align: center;
}

/* ===== 分析中 ===== */
.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255,255,255,0.1);
  border-top: 6rpx solid #4A90E2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.analyzing-hint {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.progress-bar-bg {
  width: 60%;
  height: 8rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #7B68EE);
  border-radius: 4rpx;
  width: 80%;
  animation: progress-pulse 1.5s ease-in-out infinite;
}

@keyframes progress-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* ===== 结果页 ===== */
.result-state {
  width: 100%;
}

.score-card {
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.15), rgba(123, 104, 238, 0.1));
  border: 1px solid rgba(74, 144, 226, 0.2);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.score-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90E2, #7B68EE);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 40rpx rgba(74, 144, 226, 0.3);
}

.score-number {
  font-size: 72rpx;
  color: #fff;
  font-weight: 800;
  line-height: 1;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.score-grade {
  font-size: 32rpx;
  color: #a0c4ff;
  font-weight: 600;
}

/* 摘要 */
.summary-section, .timeline-section, .dimensions-section {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.section-title {
  font-size: 28rpx;
  color: #a0c4ff;
  display: block;
  margin-bottom: 24rpx;
  font-weight: 600;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.summary-item {
  text-align: center;
  padding: 20rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
}

.summary-value {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
  display: block;
}

.summary-unit {
  font-size: 20rpx;
  color: #666;
  margin-left: 4rpx;
}

.summary-label {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-top: 6rpx;
}

/* 时间线 */
.timeline-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.timeline-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  gap: 10rpx;
}

.timeline-time {
  font-size: 22rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.timeline-bar-bg {
  flex: 1;
  height: 16rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 8rpx;
  overflow: hidden;
}

.timeline-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #7B68EE);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.timeline-pct {
  font-size: 20rpx;
  color: #888;
  width: 45rpx;
  text-align: right;
}

.timeline-energy {
  font-size: 18rpx;
  width: 40rpx;
  text-align: center;
}

.energy-high { color: #ff6b6b; }
.energy-mid { color: #ffd93d; }
.energy-low { color: #6bff6b; }

/* 5维评分 */
.dimension-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  gap: 10rpx;
}

.dim-label {
  font-size: 24rpx;
  color: #ccc;
  width: 180rpx;
  flex-shrink: 0;
}

.dim-bar-bg {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 6rpx;
  overflow: hidden;
}

.dim-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #7B68EE);
  border-radius: 6rpx;
}

.dim-value {
  font-size: 24rpx;
  color: #a0c4ff;
  width: 40rpx;
  text-align: right;
  font-weight: 600;
}

