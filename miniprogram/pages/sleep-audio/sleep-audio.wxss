/**
 * pages/sleep-audio/sleep-audio.wxss — AI助眠播放
 */
page { background: #0f0f23; min-height: 100vh; }

.container { padding: 30rpx; }

/* ===== 头部 ===== */
.header {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.header-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 16rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e0d8f0;
  display: block;
}

.header-subtitle {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-top: 8rpx;
}

/* ===== 模式卡片 ===== */
.mode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 30rpx 0;
}

.mode-card {
  width: calc(50% - 10rpx);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.2s;
}

.mode-card:active {
  transform: scale(0.97);
  background: rgba(255,255,255,0.08);
}

.mode-card.selected {
  border-color: #667eea;
  background: rgba(102,126,234,0.12);
  box-shadow: 0 0 24rpx rgba(102,126,234,0.15);
}

.mode-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 12rpx;
}

.mode-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #e0d8f0;
  display: block;
}

.mode-desc {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ===== 场景信息 ===== */
.scene-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 0;
}

.scene-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0d8f0;
  display: block;
  margin-bottom: 16rpx;
}

.scene-desc {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.7;
  display: block;
}

/* ===== 播放控制 ===== */
.play-btn-wrapper {
  margin: 30rpx 0;
  display: flex;
  justify-content: center;
}

.play-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  box-shadow: 0 12rpx 48rpx rgba(102,126,234,0.4);
  transition: all 0.2s;
}

.play-btn:active {
  transform: scale(0.93);
}

.play-btn.playing {
  animation: pulse-shadow 2s ease-in-out infinite;
}

@keyframes pulse-shadow {
  0%, 100% { box-shadow: 0 12rpx 48rpx rgba(102,126,234,0.4); }
  50% { box-shadow: 0 12rpx 64rpx rgba(102,126,234,0.7); }
}

/* ===== 进度 ===== */
.progress-area {
  margin: 24rpx 0;
  text-align: center;
}

.progress-bar-container {
  width: 100%;
  height: 6rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #a78bfa);
  border-radius: 3rpx;
  transition: width 0.3s;
}

.progress-time {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-top: 10rpx;
}

/* ===== 蓝牙状态 ===== */
.bt-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #888;
  margin: 16rpx 0;
}

.bt-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
}

.bt-dot.connected { background: #4caf50; }
.bt-dot.disconnected { background: #ff6b6b; }

/* ===== 说明 ===== */
.tip-box {
  background: rgba(255,193,7,0.06);
  border: 1px solid rgba(255,193,7,0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 30rpx 0;
}

.tip-text {
  font-size: 24rpx;
  color: #ccb26e;
  line-height: 1.6;
  display: block;
}

/* ===== 音频日志 ===== */
.log-area {
  background: rgba(0,0,0,0.3);
  border-radius: 16rpx;
  padding: 16rpx;
  max-height: 200rpx;
  overflow-y: auto;
  margin-top: 20rpx;
}

.log-line {
  font-size: 20rpx;
  color: #555;
  font-family: monospace;
  display: block;
  line-height: 1.6;
}
