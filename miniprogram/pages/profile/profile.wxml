<!-- pages/profile/profile.wxml — 用户中心（专业版） -->
<view class="container">
  
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-layer">
    <view class="spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <scroll-view class="profile-scroll" scroll-y wx:else show-scrollbar="{{false}}">
    
    <!-- ===== 用户卡片 ===== -->
    <view class="user-hero-card">
      <view class="hero-glow"></view>
      
      <view class="avatar-area">
        <button wx:if="{{!userInfo.avatarUrl}}" class="avatar-btn" open-type="getUserInfo" bindgetuserinfo="getUserInfo">
          <view class="avatar-placeholder">👤</view>
        </button>
        <image wx:else class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        
        <view class="user-meta">
          <text class="user-name">{{userInfo.nickname}}</text>
          <view class="level-badge" style="background: {{getLevelInfo(member.level).color}}15; border-color: {{getLevelInfo(member.level).color}}30;">
            <text>{{getLevelInfo(member.level).icon}} {{getLevelInfo(member.level).label}}</text>
          </view>
          <text class="joined-date">加入 {{member.joinedAt}}</text>
        </view>
      </view>
      
      <!-- 统计行 -->
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value">{{member.totalSessions}}</text>
          <text class="stat-label">分析次数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{member.avgScore}}</text>
          <text class="stat-label">总平均分</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{member.avgScore7d}}</text>
          <text class="stat-label">近7日平均</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value highlight">{{member.streakDays}}</text>
          <text class="stat-label">连续🔥</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{member.totalDays}}</text>
          <text class="stat-label">累计天数</text>
        </view>
      </view>
    </view>

    <!-- ===== 功能导航 ===== -->
    <view class="menu-section">
      <text class="menu-section-label">功能导航</text>
      
      <view class="menu-list">
        <view class="menu-item" wx:for="{{menuItems}}" wx:key="page" 
              data-page="{{item.page}}" bindtap="handleNavClick">
          <view class="menu-icon-wrap">
            <text class="menu-icon">{{item.icon}}</text>
          </view>
          <view class="menu-content">
            <text class="menu-text">{{item.text}}</text>
            <text class="menu-desc">{{item.desc}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- ===== 减压画像 ===== -->
    <view class="menu-section" wx:if="{{relaxStats.total_sessions > 0}}">
      <text class="menu-section-label">🧘 减压画像</text>
      
      <view class="relax-card">
        <view class="relax-grid">
          <view class="relax-item">
            <text class="relax-val highlight">{{relaxStats.total_sessions}}</text>
            <text class="relax-lbl">减压次数</text>
          </view>
          <view class="relax-item">
            <text class="relax-val">{{relaxStats.completed_sessions}}</text>
            <text class="relax-lbl">完整完成</text>
          </view>
          <view class="relax-item">
            <text class="relax-val highlight">{{relaxStats.relax_streak_days}}</text>
            <text class="relax-lbl">连续减压🔥</text>
          </view>
          <view class="relax-item">
            <text class="relax-val">{{formatDuration(relaxStats.avg_duration)}}</text>
            <text class="relax-lbl">平均时长</text>
          </view>
        </view>

        <!-- 压力类型分布 -->
        <view class="stress-tags" wx:if="{{relaxStats.stress_types.length > 0}}">
          <text class="stress-tag" wx:for="{{relaxStats.stress_types}}" wx:key="type">
            {{item.type}} ×{{item.count}}
          </text>
        </view>

        <!-- 完成率 -->
        <view class="completion-row" wx:if="{{relaxStats.total_sessions > 0}}">
          <text class="completion-lbl">完成率</text>
          <view class="completion-bar">
            <view class="completion-fill" style="width: {{relaxStats.total_sessions > 0 ? (relaxStats.completed_sessions / relaxStats.total_sessions * 100) : 0}}%"></view>
          </view>
          <text class="completion-pct">{{relaxStats.total_sessions > 0 ? Math.round(relaxStats.completed_sessions / relaxStats.total_sessions * 100) : 0}}%</text>
        </view>
      </view>
    </view>

    <!-- ===== 版本信息 ===== -->
    <view class="footer-info">
      <text class="footer-name">AISleepGen</text>
      <text class="footer-version">v1.0.0</text>
      <text class="footer-tagline">AI 驱动的睡眠分析助手</text>
    </view>
    
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
