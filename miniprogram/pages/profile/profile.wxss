/* pages/profile/profile.wxss 閳?閻劍鍩涙稉顓炵妇閿涘牅绗撴稉姘卞閿?*/
page {
  background: #0f3460;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", sans-serif;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1B2838 0%, #16213e 100%);
}

/* ===== 閸旂姾娴?===== */
.loading-layer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255,255,255,0.06);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
}

/* ===== 閸愬懎顔愬姘З ===== */
.profile-scroll {
  padding: 0 24rpx;
}

/* ===== 閻劍鍩涢崡锛勫 ===== */
.user-hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(102,126,234,0.1), rgba(52,73,220,0.05));
  border: 0.5px solid rgba(102,126,234,0.12);
  border-radius: 32rpx;
  padding: 36rpx;
  margin: 24rpx 0 20rpx;
}
.hero-glow {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  top: -60rpx;
  right: -40rpx;
  background: radial-gradient(circle, rgba(102,126,234,0.08), transparent 70%);
  pointer-events: none;
}

.avatar-area {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  padding: 0;
  margin-right: 24rpx;
  background: rgba(255,255,255,0.04);
  border: 2rpx solid rgba(255,255,255,0.06);
  line-height: normal;
  flex-shrink: 0;
}
.avatar-btn::after { border: none; }
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  min-width: 0;
}
.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}
.level-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  border: 0.5px solid;
  margin-bottom: 6rpx;
}
.joined-date {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

/* 缂佺喕顓哥悰?*/
.stats-row {
  display: flex;
  align-items: center;
  padding-top: 24rpx;
  border-top: 0.5px solid rgba(255,255,255,0.06);
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
  margin-bottom: 4rpx;
}
.stat-value.highlight {
  color: #FF9800;
}
.stat-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}
.stat-divider {
  width: 0.5px;
  height: 36rpx;
  background: rgba(255,255,255,0.06);
}

/* ===== 閸旂喕鍏樼悰銊︾壐 ===== */
.menu-section {
  margin-bottom: 20rpx;
}
.menu-section-label {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.35);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.menu-list {
  background: rgba(255,255,255,0.03);
  border: 0.5px solid rgba(255,255,255,0.05);
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 0.5px solid rgba(255,255,255,0.04);
  transition: all 0.2s;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: rgba(255,255,255,0.04); }

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-icon {
  font-size: 30rpx;
}

.menu-content {
  flex: 1;
  min-width: 0;
}
.menu-text {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-bottom: 2rpx;
}
.menu-desc {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
  display: block;
}
.menu-arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,0.12);
  margin-left: 12rpx;
}

/* ===== 妞や絻鍓?===== */
.footer-info {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.footer-name {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.15);
  display: block;
  letter-spacing: 1rpx;
}
.footer-version {
  font-size: 20rpx;
  color: rgba(255,255,255,0.1);
  display: block;
  margin: 4rpx 0;
}
.footer-tagline {
  font-size: 20rpx;
  color: rgba(255,255,255,0.08);
  display: block;
}

.bottom-spacer {
  height: 40rpx;
}

/* 减压画像卡片 */

/* 减压画像卡片 */
.relax-card {
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 30rpx;
}
.relax-grid {
  display: flex;
  flex-wrap: wrap;
}
.relax-item {
  width: 50%;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.relax-val {
  font-size: 40rpx;
  font-weight: 300;
  color: rgba(255,255,255,0.8);
}
.relax-val.highlight {
  color: #48dbfb;
}
.relax-lbl {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 6rpx;
}

/* 压力类型标签 */
.stress-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 16rpx 0 0;
  justify-content: center;
}
.stress-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  background: rgba(72, 219, 251, 0.08);
  border: 1rpx solid rgba(72, 219, 251, 0.15);
  border-radius: 20rpx;
  color: rgba(72, 219, 251, 0.5);
}

/* 完成率 */
.completion-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}
.completion-lbl {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  width: 80rpx;
}
.completion-bar {
  flex: 1;
  height: 4rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 4rpx;
  overflow: hidden;
}
.completion-fill {
  height: 100%;
  background: linear-gradient(90deg, #48dbfb, #667eea);
  border-radius: 4rpx;
  transition: width 0.5s;
}
.completion-pct {
  font-size: 22rpx;
  color: rgba(72, 219, 251, 0.6);
  width: 50rpx;
  text-align: right;
}

/* ===== AI智能推荐卡片 ===== */
.recommend-card {
  position: relative;
  background: linear-gradient(135deg, rgba(255, 193, 7, 0.08), rgba(255, 152, 0, 0.04));
  border: 1rpx solid rgba(255, 193, 7, 0.15);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.recommend-badge {
  font-size: 22rpx;
  color: rgba(255, 193, 7, 0.7);
  background: rgba(255, 193, 7, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.recommend-close {
  font-size: 28rpx;
  color: rgba(255,255,255,0.2);
  padding: 8rpx;
}
.recommend-icon {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 193, 7, 0.9);
  margin-bottom: 8rpx;
}
.recommend-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.recommend-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recommend-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF9800;
}
.recommend-unit {
  font-size: 22rpx;
  color: rgba(255,152,0,0.5);
  font-weight: 400;
}
.recommend-btn {
  background: linear-gradient(135deg, #FF9800, #FFC107);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* ===== 会员升级入口卡片 ===== */
.upgrade-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.08), rgba(255, 193, 7, 0.04));
  border: 1rpx solid rgba(246, 211, 101, 0.12);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.upgrade-card:active {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.12), rgba(255, 193, 7, 0.06));
}
.upgrade-card-glow {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  top: -50rpx;
  right: -30rpx;
  background: radial-gradient(circle, rgba(246,211,101,0.06), transparent 70%);
  pointer-events: none;
}
.upgrade-card-content {
  display: flex;
  align-items: center;
}
.upgrade-card-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.upgrade-card-text {
  flex: 1;
}
.upgrade-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  margin-bottom: 4rpx;
}
.upgrade-card-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
}
.upgrade-card-arrow {
  font-size: 36rpx;
  color: rgba(255,255,255,0.15);
  margin-left: 12rpx;
}

/* ===== 升级弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}
.modal-content {
  width: 100%;
  background: #1a1a3e;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 32rpx 60rpx;
  max-height: 85vh;
  overflow-y: auto;
}

/* 成功状态 */
.upgrade-success {
  text-align: center;
  padding: 60rpx 0 40rpx;
}
.success-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.success-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #48dbfb;
  margin-bottom: 12rpx;
}
.success-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
.modal-close {
  font-size: 32rpx;
  color: rgba(255,255,255,0.2);
  padding: 8rpx;
}

/* 当前等级 */
.current-tier {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}
.current-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
}
.current-value {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.6);
}

/* 套餐选择 */
.tier-select {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.tier-option {
  flex: 1;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
}
.tier-option.tier-active {
  background: rgba(102, 126, 234, 0.1);
  border-color: rgba(102, 126, 234, 0.4);
}
.tier-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.tier-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  margin-bottom: 4rpx;
}
.tier-price {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #667eea;
}
.tier-unit {
  font-size: 20rpx;
  color: rgba(102,126,234,0.5);
  font-weight: 400;
}
.tier-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 4rpx;
}

/* 周期选择 */
.period-select {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.period-option {
  flex: 1;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 16rpx;
  text-align: center;
  position: relative;
}
.period-option.period-active {
  background: rgba(102, 126, 234, 0.08);
  border-color: rgba(102, 126, 234, 0.3);
}
.period-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 4rpx;
}
.period-price {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
}
.period-badge {
  display: inline-block;
  font-size: 18rpx;
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  margin-top: 4rpx;
}

/* 支付按钮 */
.pay-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea, #48dbfb);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.pay-btn[disabled] {
  opacity: 0.5;
}
.pay-notice {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255,255,255,0.15);
  margin-top: 16rpx;
}
